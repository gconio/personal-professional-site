---
const publicationFiles = import.meta.glob('/src/content/pubblicazioni/**/*.{md,mdx}', {
  eager: true,
  query: '?raw',
  import: 'default',
}) as Record<string, string>;

const today = new Date();
today.setHours(23, 59, 59, 999);

const visibleDates = Object.values(publicationFiles)
  .map((content) => content.match(/^visibleFrom\s*:\s*["']?([^"'\r\n]+)["']?\s*$/m)?.[1]?.trim())
  .filter((value): value is string => Boolean(value))
  .map((value) => new Date(`${value}T00:00:00`))
  .filter((date) => !Number.isNaN(date.getTime()) && date <= today)
  .sort((a, b) => b.getTime() - a.getTime());

const lastUpdate = visibleDates[0] ?? new Date();
const formattedLastUpdate = new Intl.DateTimeFormat('it-IT', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(lastUpdate);
---

<footer class="site-footer">
  <div>
    <strong>Giovanni CONIO — Lab4Int - Intelligence Analysis Laboratory</strong>
    <p>Analisi intelligence, formazione avanzata e cultura strategica.</p>
    <p class="footer-legal-note">Sito personale/professionale.</p>
    <p class="footer-update-note">Contenuti aggiornati al {formattedLastUpdate}.</p>
  </div>
  <div class="footer-links" aria-label="Link principali e legali">
