---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const progetti = await getCollection('progetto');
  return progetti.map((progetto) => ({ params: { slug: progetto.id }, props: { progetto } }));
}

const { progetto } = Astro.props;
const { Content } = await render(progetto);
const isIntelSimProject = progetto.id === 'intel-sim-platform';
const projectCtaTitle = isIntelSimProject
  ? 'Approfondire la piattaforma Intel Sim'
  : 'Approfondire il progetto';
const projectCtaText = isIntelSimProject
  ? 'Il progetto può essere presentato o sperimentato in contesti didattici, universitari e professionali interessati a simulazioni intelligence, crisis management e valutazione del processo analitico.'
  : 'Per collaborazioni, sperimentazioni didattiche, iniziative culturali o approfondimenti progettuali è possibile avviare un confronto diretto.';
const projectCtaPrimaryLabel = isIntelSimProject ? 'Proponi una sperimentazione' : 'Proponi una collaborazione';
const siteUrl = 'https://giovanni.conio.lab4int.com';
const pageUrl = `${siteUrl}/progetti/${progetto.id}/`;
const pageTitle = `${progetto.data.title} — Progetti | Lab4Int`;
const projectImage = isIntelSimProject ? '/images/projects/intelsim/intelsim-login-access.png' : '/images/logo-gc.png';
const projectStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': isIntelSimProject ? 'SoftwareApplication' : 'CreativeWork',
    name: progetto.data.title,
    description: progetto.data.description,
    url: pageUrl,
    inLanguage: 'it-IT',
    applicationCategory: isIntelSimProject ? 'EducationalApplication' : undefined,
    operatingSystem: isIntelSimProject ? 'Web' : undefined,
    creator: {
      '@type': 'Person',
      name: 'Giovanni CONIO',
      url: `${siteUrl}/chi-sono/`
    },
    publisher: {
      '@type': 'Organization',
      name: 'Lab4Int - Intelligence Analysis Laboratory',
      url: siteUrl
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Progetti', item: `${siteUrl}/progetti/` },
      { '@type': 'ListItem', position: 3, name: progetto.data.title, item: pageUrl }
    ]
  }
];
---
<BaseLayout
  title={pageTitle}
  description={progetto.data.description}
  image={projectImage}
  type="article"
  structuredData={projectStructuredData}
>
  <article class="article-page">
    <header class="article-header">
      <p class="eyebrow">Progetto</p>
      <h1>{progetto.data.title}</h1>
      <p class="article-meta">{progetto.data.status} · {progetto.data.category}</p>
    </header>
    <div class="prose">
      <Content />
    </div>

    <section class="panel page-cta project-cta" aria-labelledby="project-cta-title">
      <div>
        <p class="card-meta">Collaborazioni</p>
        <h2 id="project-cta-title">{projectCtaTitle}</h2>
        <p>{projectCtaText}</p>
      </div>
      <div class="page-cta-actions">
        <a class="button primary" href="/contatti/">{projectCtaPrimaryLabel}</a>
        <a class="button secondary" href="/progetti/">Torna ai progetti</a>
      </div>
    </section>

    <style>
      .page-cta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.25rem;
        margin-top: 2.5rem;
      }

      .page-cta h2 {
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        margin-bottom: 0.55rem;
      }

      .page-cta p {
        max-width: 760px;
        margin: 0;
        color: var(--text-muted);
      }

      .page-cta-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        justify-content: flex-end;
      }

      @media (max-width: 860px) {
        .page-cta {
          align-items: flex-start;
          flex-direction: column;
        }

        .page-cta-actions {
          justify-content: flex-start;
        }
      }
    </style>
  </article>
</BaseLayout>
