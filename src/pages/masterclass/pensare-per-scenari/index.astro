---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const registrationUrl = 'https://forms.gle/Ku4o7kFFtJsC1JdF9';
const posterUrl = '/images/masterclass/masterclass-pensare-per-scenari-2026.png';
const pageTitle = 'Masterclass Pensare per scenari — Lab4Int';
const pageDescription = 'Masterclass Lab4Int: Pensare per scenari. Dall’incertezza agli indicatori: laboratorio di intelligence analysis.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Pensare per scenari. Dall’incertezza agli indicatori',
  description: pageDescription,
  startDate: '2026-09-17T17:00:00+02:00',
  endDate: '2026-09-17T20:00:00+02:00',
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  image: `https://giovanni.conio.lab4int.com${posterUrl}`,
  organizer: {
    '@type': 'Organization',
    name: 'Lab4Int - Intelligence Analysis Laboratory',
    url: 'https://giovanni.conio.lab4int.com/'
  },
  performer: {
    '@type': 'Person',
    name: 'Giovanni CONIO',
    url: 'https://giovanni.conio.lab4int.com/chi-sono/'
  },
  url: 'https://giovanni.conio.lab4int.com/masterclass/pensare-per-scenari/'
};

const learningPoints = [
  'Formulare una focal question orientata alla decisione.',
  'Individuare attori, driver e incertezze critiche.',
  'Costruire scenari plausibili mediante una matrice 2x2.',
  'Tradurre gli scenari in pathway e indicatori osservabili.',
  'Comunicare probabilità, impatto e livello di fiducia.'
];

const modules = [
  ['Dalla crisi al problema', 'T0, giudizio iniziale, focal question e confini del sistema.'],
  ['Costruire lo spazio degli scenari', 'Attori, driver, incertezze critiche e matrice 2x2.'],
  ['Dare causalità al futuro', 'Trigger, meccanismi, risposte, effetti e pathway.'],
  ['Rendere gli scenari monitorabili', 'Indicatori, soglie, fonti e priorità informative.'],
  ['Briefing e debriefing', 'BLUF, implicazioni decisionali, revisione del giudizio e lezioni apprese.']
];

const courseLinks = [
  ['Fondamenti di intelligence', '/didattica/fondamenti-di-intelligence/', 'Se ti manca il quadro del ciclo e dei requisiti.'],
  ['Analisi intelligence', '/didattica/analisi-intelligence/', 'Se vuoi strutturare giudizi, ipotesi, SATs e indicatori.'],
  ['Conflict Analysis', '/didattica/conflict-analysis/', 'Se vuoi leggere cause, attori e dinamiche dei conflitti.'],
  ['Intell Production', '/didattica/intell-production/', 'Se vuoi rendere l’analisi chiara e utile al decisore.'],
  ['Simulazioni intelligence e crisis management', '/didattica/simulazioni-intelligence/', 'Se vuoi applicare il metodo sotto pressione.']
];

const faqs = [
  ['È richiesta esperienza precedente?', 'No. Il metodo è introdotto durante la sessione; una familiarità con analisi, geopolitica o supporto decisionale è utile ma non necessaria.'],
  ['Il caso è reale?', 'No. È un caso fittizio costruito su dinamiche plausibili per evitare attribuzioni e consentire il controllo didattico.'],
  ['È un corso di geopolitica sul Mediterraneo?', 'No. Il contesto serve a esercitare metodo, scenari, pathway, indicatori e comunicazione al decisore.'],
  ['Esiste una soluzione corretta?', 'No. Gli output vengono valutati per plausibilità, distinzione, coerenza, rilevanza e monitorabilità.'],
  ['Quali materiali sono inclusi?', 'Dossier, worksheet, template di briefing e checklist conclusiva.']
];
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={posterUrl}
  type="website"
  canonical="/masterclass/pensare-per-scenari/"
  structuredData={structuredData}
>
  <section class="masterclass-page">
    <div class="masterclass-hero">
      <div class="masterclass-hero-copy">
        <p class="eyebrow">Masterclass Lab4Int · Settembre 2026</p>
        <h1>Pensare per scenari</h1>
        <p class="masterclass-subtitle">Dall’incertezza agli indicatori: laboratorio di intelligence analysis</p>
        <p class="masterclass-claim">Il futuro non si indovina. Si esplora, si struttura e si monitora.</p>
        <p>
          Quando le informazioni sono incomplete e le fonti contraddittorie, il compito dell’analista non è indovinare il futuro.
          È costruire alternative plausibili, riconoscere i segnali che le distinguono e preparare decisioni robuste.
        </p>
        <div class="inline-actions">
          <a class="button primary" href={registrationUrl} target="_blank" rel="noopener noreferrer">Iscriviti alla Masterclass</a>
          <a class="button secondary" href="#programma">Vedi programma</a>
        </div>
      </div>

      <figure class="masterclass-poster-panel">
        <a href={registrationUrl} target="_blank" rel="noopener noreferrer" aria-label="Apri il modulo di iscrizione alla Masterclass">
          <img src={posterUrl} alt="Locandina Masterclass Lab4Int Pensare per scenari" loading="eager" decoding="async" />
        </a>
      </figure>
    </div>

    <section class="masterclass-facts panel" aria-label="Informazioni essenziali">
      <div><strong>Data</strong><span>17 settembre 2026</span><small>Giovedì, 17:00 – 20:00</small></div>
      <div><strong>Durata</strong><span>3 ore</span><small>Laboratorio intensivo</small></div>
      <div><strong>Partecipanti</strong><span>25–30</span><small>Numero indicativo</small></div>
      <div><strong>Formato</strong><span>Online</span><small>Dettagli agli iscritti</small></div>
    </section>

    <section class="page-section compact-section masterclass-section">
      <div class="grid-two masterclass-intro-grid">
        <article class="card">
          <p class="card-meta">Formato</p>
          <h2>Tre ore, un dossier di crisi, molteplici futuri plausibili</h2>
          <p>
            La masterclass propone un laboratorio intensivo basato su una crisi simulata nel Mediterraneo centrale.
            A partire dallo stesso dossier informativo, i partecipanti costruiranno scenari diversi, ne svilupperanno
            i pathway e definiranno indicatori osservabili per il monitoraggio.
          </p>
        </article>
        <article class="card">
          <p class="card-meta">Destinatari</p>
          <h2>A chi è rivolta</h2>
          <p>
            Professionisti dell’intelligence e della sicurezza, analisti geopolitici, decisori, manager,
            responsabili della pianificazione, ricercatori, consulenti, studenti magistrali e frequentatori di master.
          </p>
        </article>
      </div>
    </section>

    <section class="masterclass-section panel" id="programma">
      <p class="eyebrow">Cosa imparerai</p>
      <h2>Metodo, scenari, pathway e indicatori</h2>
      <ul class="masterclass-checklist">
        {learningPoints.map((point) => <li>{point}</li>)}
      </ul>
    </section>

    <section class="masterclass-section">
      <p class="eyebrow">Programma pubblico</p>
      <h2>La sequenza del laboratorio</h2>
      <div class="masterclass-programme">
        {modules.map(([title, description], index) => (
          <article class="card masterclass-module">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="masterclass-section feature-band masterclass-cta-band">
      <div class="page-section compact-section">
        <p class="eyebrow">Registrazione</p>
        <h2>Richiedi informazioni o registra il tuo interesse</h2>
        <p>
          I dettagli organizzativi e il link definitivo saranno comunicati agli iscritti.
          Per informazioni: <a class="text-link" href="mailto:info@lab4int.com">info@lab4int.com</a>.
        </p>
        <div class="inline-actions">
          <a class="button primary" href={registrationUrl} target="_blank" rel="noopener noreferrer">Compila il modulo</a>
          <a class="button secondary" href="/didattica/">Scopri i percorsi Lab4Int</a>
        </div>
      </div>
    </section>

    <section class="masterclass-section">
      <p class="eyebrow">Dopo la masterclass</p>
      <h2>Ponte verso i percorsi formativi Lab4Int</h2>
      <div class="grid-three masterclass-course-grid">
        {courseLinks.map(([title, href, description]) => (
          <article class="card">
            <h3>{title}</h3>
            <p>{description}</p>
            <a class="card-link" href={href}>Apri scheda corso</a>
          </article>
        ))}
      </div>
    </section>

    <section class="masterclass-section panel">
      <p class="eyebrow">FAQ</p>
      <h2>Domande frequenti</h2>
      <div class="masterclass-faq-list">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>
  </section>

  <style>
    .masterclass-page {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 4.5rem 1.25rem;
    }

    .masterclass-hero {
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(320px, 1.05fr);
      gap: 1.5rem;
      align-items: center;
    }

    .masterclass-hero-copy {
      display: grid;
      gap: 1rem;
    }

    .masterclass-hero-copy h1 {
      font-size: clamp(3rem, 8vw, 5.8rem);
    }

    .masterclass-hero-copy p {
      margin: 0;
      color: var(--text-muted);
      font-size: 1.05rem;
    }

    .masterclass-subtitle {
      color: var(--primary) !important;
      font-weight: 900;
      font-size: clamp(1.2rem, 2.5vw, 1.65rem) !important;
    }

    .masterclass-claim {
      color: var(--accent) !important;
      font-weight: 900;
    }

    .masterclass-poster-panel {
      margin: 0;
      padding: 0.65rem;
      border: 1px solid var(--border);
      border-radius: 26px;
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .masterclass-poster-panel img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 20px;
    }

    .masterclass-facts {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .masterclass-facts div {
      display: grid;
      gap: 0.25rem;
      padding: 0.85rem;
      border-radius: 16px;
      background: var(--surface-muted);
    }

    .masterclass-facts strong {
      color: var(--accent);
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .masterclass-facts span {
      color: var(--primary);
      font-weight: 900;
    }

    .masterclass-facts small {
      color: var(--text-muted);
    }

    .masterclass-section {
      margin-top: 3.5rem;
    }

    .masterclass-section > h2,
    .masterclass-section > .eyebrow {
      max-width: 760px;
    }

    .masterclass-intro-grid h2,
    .masterclass-section h2 {
      margin-bottom: 0.75rem;
    }

    .masterclass-checklist {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem;
      padding: 0;
      margin: 1.25rem 0 0;
      list-style: none;
    }

    .masterclass-checklist li {
      padding: 0.9rem 1rem;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--surface);
      color: var(--text-muted);
      font-weight: 700;
    }

    .masterclass-programme {
      display: grid;
      gap: 1rem;
      margin-top: 1.25rem;
    }

    .masterclass-module {
      display: grid;
      grid-template-columns: 54px minmax(0, 1fr);
      align-items: start;
    }

    .masterclass-module > span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: var(--primary);
      color: #fff;
      font-weight: 900;
    }

    .masterclass-module h3 {
      margin-bottom: 0.35rem;
    }

    .masterclass-cta-band {
      border-radius: 28px;
      overflow: hidden;
    }

    .masterclass-cta-band .button.secondary {
      color: #fff;
      border-color: rgba(255,255,255,0.24);
    }

    .masterclass-course-grid {
      margin-top: 1.25rem;
    }

    .masterclass-faq-list {
      display: grid;
      gap: 0.75rem;
      margin-top: 1rem;
    }

    .masterclass-faq-list details {
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--surface);
      padding: 1rem;
    }

    .masterclass-faq-list summary {
      cursor: pointer;
      color: var(--primary);
      font-weight: 900;
    }

    .masterclass-faq-list p {
      margin: 0.75rem 0 0;
      color: var(--text-muted);
    }

    @media (max-width: 880px) {
      .masterclass-hero,
      .masterclass-facts,
      .masterclass-checklist {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
