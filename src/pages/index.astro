---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import SectionHeading from '../components/SectionHeading.astro';

const corsi = (await getCollection('corso'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const progetti = (await getCollection('progetto'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const normalize = (value = '') => value.toLowerCase();

const isRecentPublicationCandidate = (pubblicazione) => {
  const type = normalize(pubblicazione.data.type);
  const publisher = normalize(pubblicazione.data.publisher || '');

  return (
    type.includes('articolo online') ||
    type.includes('contributo online') ||
    (type.includes('articolo') && publisher.includes('lab4int')) ||
    (pubblicazione.data.pdfUrl && publisher.includes('lab4int'))
  );
};

const pubblicazioni = (await getCollection('pubblicazione'))
  .filter(isRecentPublicationCandidate)
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year || a.data.title.localeCompare(b.data.title, 'it'))
  .slice(0, 3);

const latestInterview = (await getCollection('media'))
  .filter((entry) => entry.data.youtubeId && `${entry.data.category} ${entry.data.type}`.toLowerCase().includes('intervist'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || a.data.order - b.data.order)[0];

const siteUrl = 'https://giovanni.conio.lab4int.com';
const homeTitle = 'Giovanni CONIO — Lab4Int | Intelligence Analysis Laboratory';
const homeDescription = 'Sito personale e professionale dedicato a intelligence analysis, formazione avanzata, tecniche analitiche strutturate, simulazioni, pubblicazioni e cultura strategica.';
const homeImage = '/images/brand/lab4int-logo-visual.png';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Lab4Int - Intelligence Analysis Laboratory',
    alternateName: 'Lab4Int',
    url: siteUrl,
    inLanguage: 'it-IT',
    description: homeDescription,
    publisher: {
      '@type': 'Organization',
      name: 'Lab4Int - Intelligence Analysis Laboratory',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/images/logo-gc.png`
      }
    },
    creator: {
      '@type': 'Person',
      name: 'Giovanni CONIO',
      url: `${siteUrl}/chi-sono/`
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Lab4Int - Intelligence Analysis Laboratory',
    alternateName: 'Lab4Int',
    url: siteUrl,
    logo: `${siteUrl}/images/logo-gc.png`,
    description: 'Laboratorio professionale e culturale dedicato ad analisi intelligence, formazione avanzata, simulazioni e cultura strategica.',
    founder: {
      '@type': 'Person',
      name: 'Giovanni CONIO',
      url: `${siteUrl}/chi-sono/`
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Giovanni CONIO',
    url: `${siteUrl}/chi-sono/`,
    image: `${siteUrl}/images/profile/giovanni-conio.png`,
    jobTitle: 'Intelligence analyst e formatore',
    description: 'Esperto di intelligence analysis, OSINT, tecniche analitiche strutturate, formazione specialistica, simulazioni e cultura strategica.',
    worksFor: {
      '@type': 'Organization',
      name: 'Lab4Int - Intelligence Analysis Laboratory',
      url: siteUrl
    },
    knowsAbout: [
      'Intelligence analysis',
      'OSINT',
      'Structured Analytic Techniques',
      'Analysis of Competing Hypotheses',
      'Intelligence production',
      'Crisis management',
      'Cultura strategica'
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: `${siteUrl}/`
      }
    ]
  }
];
---
<BaseLayout
  title={homeTitle}
  description={homeDescription}
  image={homeImage}
  type="website"
  canonical="/"
  structuredData={structuredData}
>
  <Hero
    eyebrow="Formazione · Analisi · Cultura strategica"
    title="Analisi intelligence, formazione avanzata e cultura strategica"
    description="Lab4Int raccoglie attività didattiche, pubblicazioni, progetti e iniziative dedicate all’intelligence analysis, alle metodologie strutturate e alla comprensione degli scenari complessi."
    primaryHref="/chi-sono/"
    primaryLabel="Chi sono"
    secondaryHref="/pubblicazioni/"
    secondaryLabel="Pubblicazioni"
  />

  <section class="page-section">
    <SectionHeading
      eyebrow="Aree di attività"
      title="Didattica, ricerca applicata e divulgazione qualificata"
      description="Il sito è pensato come archivio professionale e laboratorio culturale: corsi, seminari, pubblicazioni, strumenti didattici e progetti metodologici rivolti a università, centri di formazione, enti, professionisti e comunità interessate all’analisi strategica."
    />
    <div class="grid-three">
      <article class="card">
        <p class="card-meta">Didattica</p>
        <h3>Corsi e workshop</h3>
        <p>Percorsi formativi su intelligence analysis, tecniche analitiche strutturate, conflict analysis, produzione intelligence e simulazioni operative.</p>
        <a class="card-link" href="/didattica/">Vedi la didattica</a>
      </article>
      <article class="card">
        <p class="card-meta">Pubblicazioni</p>
        <h3>Libri, paper e articoli</h3>
        <p>Archivio ordinato di libri, paper dottrinali, contributi online e materiali scaricabili pubblicati su piattaforme istituzionali, associative e professionali.</p>
        <a class="card-link" href="/pubblicazioni/">Vedi le pubblicazioni</a>
      </article>
      <article class="card">
        <p class="card-meta">Progetti</p>
        <h3>Laboratori e piattaforme</h3>
        <p>Progetti digitali, simulazioni geopolitiche, strumenti metodologici e iniziative dedicate alla formazione avanzata degli analisti.</p>
        <a class="card-link" href="/progetti/">Vedi i progetti</a>
      </article>
      <article class="card">
        <p class="card-meta">Interviste</p>
        <h3>Interviste e dialoghi</h3>
        <p>Interviste, dialoghi, registrazioni audio e materiali pubblici direttamente collegati ad analisi intelligence e formazione.</p>
        <a class="card-link" href="/interviste/">Vedi le interviste</a>
      </article>
    </div>
  </section>

  <section class="feature-band">
    <div class="page-section">
      <SectionHeading
        eyebrow="In evidenza"
        title="Progetti e percorsi principali"
        description="Una selezione di iniziative dedicate alla formazione, alla simulazione e allo sviluppo metodologico."
      />
      <div class="grid-three">
        {progetti.map((progetto) => (
          <Card
            href={`/progetti/${progetto.id}/`}
            title={progetto.data.title}
            meta={`${progetto.data.status} · ${progetto.data.category}`}
            description={progetto.data.description}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <SectionHeading
      eyebrow="Didattica"
      title="Percorsi formativi modulari"
      description="Le schede corso sono pensate per lezioni universitarie, seminari brevi, workshop specialistici e simulazioni operative."
    />
    <div class="grid-three">
      {corsi.map((corso) => (
        <Card
          href={`/didattica/${corso.id}/`}
          title={corso.data.title}
          meta={`${corso.data.level} · ${corso.data.duration}`}
          description={corso.data.description}
        />
      ))}
    </div>
  </section>

  {pubblicazioni.length > 0 && (
    <section class="page-section home-latest-publications" aria-labelledby="home-latest-publications-title">
      <SectionHeading
        eyebrow="Ultime pubblicazioni"
        title="Gli ultimi contributi pubblicati"
        description="Articoli, paper e materiali PDF recenti dedicati all’analisi intelligence, alla formazione avanzata e alla cultura strategica."
      />

      <div class="home-latest-publications-grid">
        {pubblicazioni.map((pubblicazione, index) => (
          <article class={`home-latest-publication-card panel ${index === 0 ? 'is-primary' : ''}`}>
            <a class="home-latest-publication-media" href={`/pubblicazioni/${pubblicazione.id}/`} aria-label={`Apri la scheda ${pubblicazione.data.title}`}>
              {pubblicazione.data.cover ? (
                <img
                  src={pubblicazione.data.cover}
                  alt={`Copertina di ${pubblicazione.data.title}`}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              ) : (
                <span class="home-publication-placeholder" aria-hidden="true">
                  <strong>{pubblicazione.data.type}</strong>
                  <small>{pubblicazione.data.year}</small>
                </span>
              )}
            </a>

            <div class="home-latest-publication-body">
              <div class="home-publication-kicker">
                {index === 0 && <span>Nuovo</span>}
                <span>{pubblicazione.data.type}</span>
                <span>{pubblicazione.data.year}</span>
                {pubblicazione.data.pdfUrl && <span>PDF</span>}
              </div>
              <h3><a href={`/pubblicazioni/${pubblicazione.id}/`}>{pubblicazione.data.title}</a></h3>
              <p>{pubblicazione.data.description}</p>
              <a class="card-link" href={`/pubblicazioni/${pubblicazione.id}/`}>Apri scheda</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {latestInterview && (
    <section class="page-section home-interview-section" aria-labelledby="home-interview-title">
      <SectionHeading
        eyebrow="Interviste"
        title="Intervista più recente"
        description="L’intervento più recente pubblicato, collegato ai temi dell’intelligence analysis, della formazione degli analisti e della cultura strategica."
      />

      <article class="panel home-interview-card">
        <div class="home-interview-layout">
          <div class="home-interview-video video-embed">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${latestInterview.data.youtubeId}`}
              title={latestInterview.data.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>

          <div class="home-interview-body">
            <p class="card-meta">{latestInterview.data.category} · {latestInterview.data.format}</p>
            <h3>{latestInterview.data.title}</h3>
            <p>{latestInterview.data.description}</p>
            <div class="inline-actions">
              <a class="button primary" href={`/interviste/`}>Apri sezione Interviste</a>
              <a class="button secondary" href={`https://www.youtube.com/watch?v=${latestInterview.data.youtubeId}`} target="_blank" rel="noopener noreferrer">Guarda su YouTube</a>
            </div>
          </div>
        </div>
      </article>
    </section>
  )}

  <section class="page-section">
    <article class="card">
      <p class="card-meta">Contatti</p>
      <h3>Collaborazioni, docenze e iniziative culturali</h3>
      <p>Per proposte didattiche, seminari, workshop, progetti editoriali o attività culturali collegate all’intelligence analysis e alla cultura strategica.</p>
      <a class="card-link" href="/contatti/">Vai ai contatti</a>
    </article>
  </section>

  <style>
    .home-latest-publications {
      display: grid;
      gap: 1.35rem;
    }

    .home-latest-publications-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .home-latest-publication-card {
      display: grid;
      grid-template-rows: auto 1fr;
      gap: 0.95rem;
      padding: 1rem;
      overflow: hidden;
    }

    .home-latest-publication-card.is-primary {
      border-color: rgba(184, 155, 94, 0.48);
      background: linear-gradient(135deg, rgba(184, 155, 94, 0.12), rgba(255, 255, 255, 0.86));
      box-shadow: 0 18px 42px rgba(11, 31, 51, 0.12);
    }

    .home-latest-publication-media {
      display: block;
      color: var(--primary);
    }

    .home-latest-publication-media img {
      display: block;
      width: 100%;
      height: 220px;
      object-fit: contain;
      border-radius: 16px;
      border: 1px solid var(--border);
      background: var(--surface-muted);
      box-shadow: 0 14px 34px rgba(11, 31, 51, 0.12);
    }

    .home-latest-publication-body {
      display: grid;
      gap: 0.7rem;
      align-content: start;
    }

    .home-latest-publication-body h3 {
      font-size: clamp(1.18rem, 2vw, 1.65rem);
      line-height: 1.08;
    }

    .home-latest-publication-body h3 a:hover {
      color: var(--secondary);
    }

    .home-latest-publication-body p {
      margin: 0;
      color: var(--text-muted);
    }

    .home-publication-kicker {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      align-items: center;
    }

    .home-publication-kicker span {
      display: inline-flex;
      align-items: center;
      min-height: 24px;
      padding: 0.2rem 0.55rem;
      border-radius: 999px;
      background: rgba(184, 155, 94, 0.12);
      color: var(--accent);
      font-size: 0.75rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .home-publication-placeholder {
      display: flex;
      min-height: 180px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(184, 155, 94, 0.18), rgba(47, 72, 88, 0.08));
      text-align: center;
      box-shadow: 0 12px 30px rgba(11, 31, 51, 0.08);
    }

    .home-publication-placeholder strong {
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--primary);
    }

    .home-publication-placeholder small {
      color: var(--text-muted);
      font-weight: 800;
    }


    .home-interview-section {
      display: grid;
      gap: 1.35rem;
    }

    .home-interview-card {
      padding: 1rem;
      overflow: hidden;
    }

    .home-interview-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
      gap: 1.2rem;
      align-items: center;
    }

    .home-interview-body {
      display: grid;
      gap: 0.85rem;
      align-content: start;
    }

    .home-interview-body h3 {
      font-size: clamp(1.35rem, 2.4vw, 2rem);
    }

    .home-interview-body p {
      margin: 0;
      color: var(--text-muted);
    }

    @media (max-width: 820px) {
      .home-latest-publications-grid {
        grid-template-columns: 1fr;
      }

      .home-latest-publication-media img {
        height: auto;
        max-height: 320px;
      }

      .home-interview-layout {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
