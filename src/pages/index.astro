---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import SectionHeading from '../components/SectionHeading.astro';

const corsi = (await getCollection('corso')).sort((a, b) => a.data.order - b.data.order).filter((entry) => entry.data.featured).slice(0, 3);
const progetti = (await getCollection('progetto')).sort((a, b) => a.data.order - b.data.order).filter((entry) => entry.data.featured).slice(0, 3);
const analisi = (await getCollection('analisi')).filter((entry) => !entry.data.draft).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
---
<BaseLayout>
  <Hero
    eyebrow="Formazione · Analisi · Cultura strategica"
    title="Analisi intelligence, formazione avanzata e cultura strategica"
    description="Attività didattiche, pubblicazioni e progetti dedicati all’intelligence analysis, alle metodologie strutturate e alla comprensione degli scenari internazionali complessi."
  />

  <section class="page-section">
    <SectionHeading
      eyebrow="Aree di attività"
      title="Una piattaforma personale per didattica, ricerca applicata e divulgazione qualificata"
      description="Il sito raccoglie corsi, seminari, pubblicazioni, strumenti didattici e progetti metodologici rivolti a università, centri di formazione, enti, professionisti e comunità culturali interessate all’analisi strategica."
    />
    <div class="grid-three">
      <article class="card">
        <p class="card-meta">Didattica</p>
        <h3>Corsi e workshop</h3>
        <p>Percorsi formativi su intelligence analysis, Structured Analytic Techniques, OSINT, conflict analysis, terrorismo e sicurezza internazionale.</p>
        <a class="card-link" href="/didattica/">Vedi la didattica</a>
      </article>
      <article class="card">
        <p class="card-meta">Pubblicazioni</p>
        <h3>Libri e materiali</h3>
        <p>Volumi, articoli, materiali didattici e risorse metodologiche per studenti, analisti e professionisti.</p>
        <a class="card-link" href="/pubblicazioni/">Vedi le pubblicazioni</a>
      </article>
      <article class="card">
        <p class="card-meta">Progetti</p>
        <h3>Laboratori e simulazioni</h3>
        <p>Progetti digitali, piattaforme formative, simulazioni geopolitiche e strumenti per l’addestramento analitico.</p>
        <a class="card-link" href="/progetti/">Vedi i progetti</a>
      </article>
    </div>
  </section>

  <section class="feature-band">
    <div class="page-section">
      <SectionHeading eyebrow="In evidenza" title="Progetti e percorsi principali" description="Una selezione iniziale di attività da valorizzare nella prima versione del sito." />
      <div class="grid-three">
        {progetti.map((progetto) => (
          <Card
            href={`/progetti/${progetto.id}/`}
            title={progetto.data.title}
            meta={`${progetto.data.status} · ${progetto.data.category}`}
            description={progetto.data.description}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <SectionHeading eyebrow="Didattica" title="Percorsi formativi modulari" description="Le schede corso sono pensate per essere adattate a lezioni universitarie, seminari brevi, workshop specialistici e simulazioni operative." />
    <div class="grid-three">
      {corsi.map((corso) => (
        <Card
          href={`/didattica/${corso.id}/`}
          title={corso.data.title}
          meta={`${corso.data.level} · ${corso.data.duration}`}
          description={corso.data.description}
        />
      ))}
    </div>
  </section>

  <section class="page-section">
    <SectionHeading eyebrow="Analisi" title="Note, riflessioni e approfondimenti" description="Una sezione editoriale leggera, pensata per pubblicare contenuti solidi e non necessariamente frequenti." />
    <div class="grid-three">
      {analisi.map((post) => (
        <Card
          href={`/analisi/${post.id}/`}
          title={post.data.title}
          meta={post.data.category}
          description={post.data.description}
          cta="Leggi"
        />
      ))}
    </div>
  </section>
</BaseLayout>
