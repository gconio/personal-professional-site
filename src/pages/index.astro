---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteTitle = 'Sito in costruzione — Nome Cognome';
const siteDescription = 'Sito professionale in costruzione. A breve saranno disponibili informazioni su attività didattiche, pubblicazioni, progetti e iniziative culturali.';
---

<BaseLayout title={siteTitle} description={siteDescription}>
  <section class="construction-page" aria-labelledby="construction-title">
    <div class="construction-card">
      <p class="eyebrow">Sito personale professionale</p>

      <h1 id="construction-title">Sito in costruzione</h1>

      <p class="lead">
        Sto preparando questo spazio per presentare attività didattiche, pubblicazioni,
        progetti culturali e iniziative dedicate all’analisi intelligence, alla formazione
        specialistica e alla cultura strategica.
      </p>

      <div class="status-panel" aria-label="Contenuti in preparazione">
        <span class="status-dot" aria-hidden="true"></span>
        <span>Nuovi contenuti in preparazione</span>
      </div>

      <div class="preview-grid" aria-label="Sezioni previste del sito">
        <article>
          <strong>Didattica</strong>
          <span>Corsi, seminari, workshop e simulazioni formative.</span>
        </article>
        <article>
          <strong>Pubblicazioni</strong>
          <span>Libri, articoli, materiali didattici e contributi culturali.</span>
        </article>
        <article>
          <strong>Progetti</strong>
          <span>Iniziative dedicate ad analisi, formazione e strumenti metodologici.</span>
        </article>
      </div>

      <div class="contact-box">
        <p>Per informazioni, collaborazioni o attività didattiche:</p>
        <a href="mailto:email@example.com">email@example.com</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .construction-page {
    min-height: calc(100vh - 190px);
    display: grid;
    place-items: center;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 5rem 1.25rem;
  }

  .construction-card {
    width: min(100%, 920px);
    background:
      radial-gradient(circle at top right, rgba(184, 155, 94, 0.18), transparent 34%),
      linear-gradient(135deg, #ffffff 0%, #f9f7f1 100%);
    border: 1px solid var(--border);
    border-radius: 32px;
    box-shadow: var(--shadow);
    padding: clamp(2rem, 5vw, 4.25rem);
  }

  .construction-card h1 {
    margin-top: 0.4rem;
    font-size: clamp(3rem, 8vw, 6rem);
    letter-spacing: -0.04em;
  }

  .lead {
    max-width: 760px;
    margin: 1.25rem 0 0;
    color: var(--text-muted);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }

  .status-panel {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2rem;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(184, 155, 94, 0.45);
    border-radius: 999px;
    background: rgba(184, 155, 94, 0.1);
    color: var(--primary);
    font-weight: 800;
  }

  .status-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 6px rgba(184, 155, 94, 0.18);
  }

  .preview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .preview-grid article {
    padding: 1.2rem;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.72);
  }

  .preview-grid strong {
    display: block;
    color: var(--primary);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .preview-grid span {
    display: block;
    margin-top: 0.55rem;
    color: var(--text-muted);
  }

  .contact-box {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .contact-box p {
    margin: 0;
    color: var(--text-muted);
  }

  .contact-box a {
    display: inline-flex;
    margin-top: 0.35rem;
    color: var(--primary);
    font-weight: 900;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 760px) {
    .construction-page {
      padding-top: 2.5rem;
      padding-bottom: 2.5rem;
    }

    .preview-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
