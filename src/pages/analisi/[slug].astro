---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('analisi')).filter((entry) => !entry.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={`${post.data.title} — Analisi`} description={post.data.description}>
  <article class="article-page">
    <header class="article-header">
      <p class="eyebrow">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="article-meta">{post.data.date.toLocaleDateString('it-IT')} · {post.data.tags.join(', ')}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
