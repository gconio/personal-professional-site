---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('analisi')).filter((entry) => !entry.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const hasFacts = post.data.publisher || post.data.category || post.data.license || post.data.sourceStatus || post.data.externalUrl || post.data.pdfUrl || post.data.tags.length > 0;
---
<BaseLayout title={`${post.data.title} — Analisi`} description={post.data.description}>
  <article class="article-page publication-page analysis-page">
    <header class="article-header">
      <p class="eyebrow">Analisi</p>
      <h1>{post.data.title}</h1>
      <p class="article-meta">{post.data.category} · {post.data.date.toLocaleDateString('it-IT')}</p>
    </header>

    {(post.data.cover || hasFacts) && (
      <section class="publication-detail-grid" aria-label="Dati principali del documento">
        {post.data.cover && (
          <aside class="panel publication-media-panel">
            <img
              src={post.data.cover}
              alt={`Copertina di ${post.data.title}`}
              class="publication-detail-cover"
              loading="eager"
              decoding="async"
            />
          </aside>
        )}

        {hasFacts && (
          <aside class="panel publication-facts">
            <h2>Dati del documento</h2>
            <dl>
              <dt>Categoria</dt><dd>{post.data.category}</dd>
              {post.data.publisher && <dt>Editore</dt>}
              {post.data.publisher && <dd>{post.data.publisher}</dd>}
              <dt>Data</dt><dd>{post.data.date.toLocaleDateString('it-IT')}</dd>
              {post.data.license && <dt>Licenza</dt>}
              {post.data.license && <dd>{post.data.license}</dd>}
              {post.data.tags.length > 0 && <dt>Temi</dt>}
              {post.data.tags.length > 0 && <dd>{post.data.tags.join(', ')}</dd>}
              {post.data.pdfUrl && <dt>PDF</dt>}
              {post.data.pdfUrl && <dd>Download disponibile</dd>}
              {post.data.sourceStatus && <dt>Disponibilità</dt>}
              {post.data.sourceStatus && <dd>{post.data.sourceStatus}</dd>}
            </dl>
            {post.data.externalUrl && (
              <a class="button primary" href={post.data.externalUrl} target="_blank" rel="noopener noreferrer">Vai al sito AIAIG</a>
            )}
            {post.data.pdfUrl && (
              <a class="button secondary" href={post.data.pdfUrl} download>Scarica PDF</a>
            )}
          </aside>
        )}
      </section>
    )}

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
