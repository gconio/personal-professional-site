---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';

const pubblicazioni = (await getCollection('pubblicazione')).sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order);
---
<BaseLayout title="Pubblicazioni — Lab4Int - Intelligence Analysis Laboratory" description="Libri, articoli, paper e materiali didattici.">
  <Hero
    eyebrow="Pubblicazioni"
    title="Libri, articoli e materiali per la cultura dell’analisi"
    description="Una raccolta ordinata di pubblicazioni, materiali didattici, contributi culturali e risorse metodologiche."
    primaryHref="/contatti/"
    primaryLabel="Richiedi informazioni"
    secondaryHref="/analisi/"
    secondaryLabel="Leggi le analisi"
  />
  <section class="page-section">
    <div class="publication-grid">
      {pubblicazioni.map((pubblicazione) => (
        <article class="panel publication-card">
          {pubblicazione.data.cover && (
            <a class="publication-card-cover" href={`/pubblicazioni/${pubblicazione.id}/`} aria-label={`Apri la scheda ${pubblicazione.data.title}`}>
              <img src={pubblicazione.data.cover} alt={`Copertina di ${pubblicazione.data.title}`} loading="lazy" decoding="async" />
            </a>
          )}
          <div class="publication-card-content">
            <p class="card-meta">{pubblicazione.data.type} · {pubblicazione.data.year}</p>
            <h3><a href={`/pubblicazioni/${pubblicazione.id}/`}>{pubblicazione.data.title}</a></h3>
            <p>{pubblicazione.data.description}</p>
            {(pubblicazione.data.isbnPrint || pubblicazione.data.isbnEbook) && (
              <dl class="publication-card-data">
                {pubblicazione.data.isbnPrint && <dt>ISBN cartaceo</dt>}
                {pubblicazione.data.isbnPrint && <dd>{pubblicazione.data.isbnPrint}</dd>}
                {pubblicazione.data.isbnEbook && <dt>ISBN ebook</dt>}
                {pubblicazione.data.isbnEbook && <dd>{pubblicazione.data.isbnEbook}</dd>}
              </dl>
            )}
            <a class="card-link" href={`/pubblicazioni/${pubblicazione.id}/`}>Approfondisci</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
