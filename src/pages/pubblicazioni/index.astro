---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';

const pubblicazioni = await getCollection('pubblicazione');

const normalize = (value = '') => value.toLowerCase();

const getVisibleFromDate = (entry) => {
  if (!entry.data.visibleFrom) return null;
  return new Date(`${entry.data.visibleFrom}T00:00:00+02:00`);
};

const getPublicationSortTime = (entry) => {
  const visibleFrom = getVisibleFromDate(entry);
  return visibleFrom ? visibleFrom.getTime() : Date.UTC(entry.data.year, 0, 1);
};

const categoryDefinitions = [
  {
    id: 'libri',
    title: 'Libri',
    description: 'Volumi e pubblicazioni monografiche dedicate all’analisi intelligence, ai metodi e alla cultura strategica.',
    match: (type) => normalize(type).includes('libro')
  },
  {
    id: 'paper',
    title: 'Paper e contributi dottrinali',
    description: 'Contributi pubblicati su siti istituzionali, associazioni, centri studi e piattaforme di approfondimento specialistico.',
    match: (type) => normalize(type).includes('paper') || normalize(type).includes('contributo dottrinale')
  },
  {
    id: 'articoli-online',
    title: 'Articoli e contributi online',
    description: 'Articoli, post e contributi pubblicati online, inclusi i contenuti divulgativi pubblicati su LinkedIn.',
    match: (type) => normalize(type).includes('articolo online') || normalize(type).includes('post') || normalize(type).includes('linkedin') || normalize(type).includes('contributo online')
  }
];

const usedIds = new Set();
const groups = categoryDefinitions
  .map((category) => {
    const items = pubblicazioni
      .filter((pubblicazione) => {
        if (usedIds.has(pubblicazione.id)) return false;
        return category.match(pubblicazione.data.type);
      })
      .sort((a, b) => getPublicationSortTime(b) - getPublicationSortTime(a) || a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'it'));

    items.forEach((item) => usedIds.add(item.id));
    return { ...category, items };
  })
  .filter((category) => category.items.length > 0);

const getActionLabel = (pubblicazione) => {
  const type = normalize(pubblicazione.data.type);
  if (type.includes('libro')) return 'Apri scheda libro';
  return 'Apri scheda';
};

const isPublisherOffline = (pubblicazione) => {
  const publisher = normalize(pubblicazione.data.publisher || '');
  return publisher.includes('alpha institute') || publisher.includes('analytica');
};

const getAvailability = (pubblicazione) => {
  if (pubblicazione.data.sourceStatus) return pubblicazione.data.sourceStatus;
  if (isPublisherOffline(pubblicazione)) return 'Sito editore non più online; PDF locale nella scheda';
  return '';
};


const isRecentArticleCandidate = (pubblicazione) => {
  const type = normalize(pubblicazione.data.type);
  const publisher = normalize(pubblicazione.data.publisher || '');
  return (
    type.includes('articolo online') ||
    type.includes('contributo online') ||
    (type.includes('articolo') && publisher.includes('lab4int')) ||
    (pubblicazione.data.pdfUrl && publisher.includes('lab4int'))
  );
};

const latestPublications = pubblicazioni
  .filter(isRecentArticleCandidate)
  .sort((a, b) => getPublicationSortTime(b) - getPublicationSortTime(a) || a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'it'))
  .slice(0, 4);

const siteUrl = 'https://giovanni.conio.lab4int.com';
const pageTitle = 'Pubblicazioni — Lab4Int - Intelligence Analysis Laboratory';
const pageDescription = 'Libri, paper, contributi dottrinali e articoli online di Giovanni CONIO dedicati ad analisi intelligence, metodologia, OSINT, SAT e cultura strategica.';
const publicationsStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Pubblicazioni',
    description: pageDescription,
    url: `${siteUrl}/pubblicazioni/`,
    inLanguage: 'it-IT',
    isPartOf: {
      '@type': 'WebSite',
      name: 'Lab4Int - Intelligence Analysis Laboratory',
      url: siteUrl
    },
    author: {
      '@type': 'Person',
      name: 'Giovanni CONIO',
      url: `${siteUrl}/chi-sono/`
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Pubblicazioni', item: `${siteUrl}/pubblicazioni/` }
    ]
  }
];
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image="/images/logo-gc.png"
  type="website"
  structuredData={publicationsStructuredData}
>
  <Hero
    eyebrow="Pubblicazioni"
    title="Libri, paper e articoli per la cultura dell’analisi"
    description="Una raccolta ordinata di libri, paper dottrinali, articoli e contributi online dedicati all’intelligence analysis."
    primaryHref="/contatti/"
    primaryLabel="Richiedi informazioni"
    secondaryHref="/didattica/"
    secondaryLabel="Scopri la didattica"
  />


  {latestPublications.length > 0 && (
    <section class="page-section latest-publications" aria-labelledby="latest-publications-title">
      <header class="latest-publications-header">
        <p class="eyebrow">Ultime pubblicazioni</p>
        <div>
          <h2 id="latest-publications-title">Gli ultimi contributi pubblicati</h2>
          <p>Articoli, paper e materiali PDF recenti dedicati all’analisi intelligence, alla formazione avanzata e alla cultura strategica.</p>
        </div>
      </header>

      <div class="latest-publications-grid">
        {latestPublications.map((pubblicazione, index) => (
          <article
            class={`latest-publication-card panel ${index === 0 ? 'is-primary' : ''}`}
            data-latest-publication
            data-scheduled-publication={pubblicazione.data.visibleFrom || undefined}
            hidden={Boolean(pubblicazione.data.visibleFrom)}
          >
            <a class="latest-publication-media" href={`/pubblicazioni/${pubblicazione.id}/`} aria-label={`Apri la scheda ${pubblicazione.data.title}`}>
              {pubblicazione.data.cover ? (
                <img src={pubblicazione.data.cover} alt={`Copertina di ${pubblicazione.data.title}`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              ) : (
                <span class="publication-placeholder" aria-hidden="true">
                  <strong>{pubblicazione.data.type}</strong>
                  <small>{pubblicazione.data.year}</small>
                </span>
              )}
            </a>

            <div class="latest-publication-body">
              <div class="publication-kicker">
                {index === 0 && <span data-new-badge>Nuovo</span>}
                <span>{pubblicazione.data.type}</span>
                <span>{pubblicazione.data.year}</span>
                {pubblicazione.data.pdfUrl && <span>PDF</span>}
              </div>
              <h3><a href={`/pubblicazioni/${pubblicazione.id}/`}>{pubblicazione.data.title}</a></h3>
              <p>{pubblicazione.data.description}</p>
              <a class="publication-button" href={`/pubblicazioni/${pubblicazione.id}/`}>Apri scheda</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="page-section publications-catalog">
    {groups.map((group) => (
      <section class="publication-section" aria-labelledby={`publication-section-${group.id}`}>
        <header class="publication-section-header">
          <p class="eyebrow">{group.items.length} {group.items.length === 1 ? 'elemento' : 'elementi'}</p>
          <div>
            <h2 id={`publication-section-${group.id}`}>{group.title}</h2>
            <p>{group.description}</p>
          </div>
        </header>

        <div class="publication-list">
          {group.items.map((pubblicazione) => {
            const availability = getAvailability(pubblicazione);
            return (
              <article
                class="publication-item panel"
                data-scheduled-publication={pubblicazione.data.visibleFrom || undefined}
                hidden={Boolean(pubblicazione.data.visibleFrom)}
              >
                <a class="publication-media" href={`/pubblicazioni/${pubblicazione.id}/`} aria-label={`Apri la scheda ${pubblicazione.data.title}`}>
                  {pubblicazione.data.cover ? (
                    <img src={pubblicazione.data.cover} alt={`Copertina di ${pubblicazione.data.title}`} loading="lazy" decoding="async" />
                  ) : (
                    <span class="publication-placeholder" aria-hidden="true">
                      <strong>{pubblicazione.data.type}</strong>
                      <small>{pubblicazione.data.year}</small>
                    </span>
                  )}
                </a>

                <div class="publication-body">
                  <div class="publication-kicker">
                    <span>{pubblicazione.data.type}</span>
                    <span>{pubblicazione.data.year}</span>
                    {pubblicazione.data.featured && <span>In evidenza</span>}
                    {pubblicazione.data.pdfUrl && <span>PDF</span>}
                  </div>

                  <h3><a href={`/pubblicazioni/${pubblicazione.id}/`}>{pubblicazione.data.title}</a></h3>
                  <p>{pubblicazione.data.description}</p>

                  <dl class="publication-metadata">
                    {pubblicazione.data.publisher && <><dt>Sede/Editore</dt><dd>{pubblicazione.data.publisher}</dd></>}
                    {pubblicazione.data.theme && <><dt>Tema</dt><dd>{pubblicazione.data.theme}</dd></>}
                    {availability && <><dt>Disponibilità</dt><dd>{availability}</dd></>}
                    {pubblicazione.data.license && <><dt>Licenza</dt><dd>{pubblicazione.data.license}</dd></>}
                    {pubblicazione.data.isbnPrint && <><dt>ISBN cartaceo</dt><dd>{pubblicazione.data.isbnPrint}</dd></>}
                    {pubblicazione.data.isbnEbook && <><dt>ISBN ebook</dt><dd>{pubblicazione.data.isbnEbook}</dd></>}
                  </dl>
                </div>

                <div class="publication-action">
                  <a class="publication-button" href={`/pubblicazioni/${pubblicazione.id}/`}>{getActionLabel(pubblicazione)}</a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </section>

  <script is:inline>
    (() => {
      const parseVisibleFrom = (value) => {
        if (!value) return null;
        return new Date(`${value}T00:00:00+02:00`);
      };

      const updateScheduledPublications = () => {
        const now = new Date();

        document.querySelectorAll('[data-scheduled-publication]').forEach((item) => {
          const visibleFrom = parseVisibleFrom(item.getAttribute('data-scheduled-publication'));
          item.hidden = Boolean(visibleFrom && now < visibleFrom);
        });

        const visibleLatestCards = Array.from(document.querySelectorAll('[data-latest-publication]'))
          .filter((card) => !card.hidden);

        visibleLatestCards.forEach((card, index) => {
          const shouldShow = index < 3;
          card.hidden = !shouldShow;
          card.classList.toggle('is-primary', shouldShow && index === 0);

          const badge = card.querySelector('[data-new-badge]');
          if (badge) {
            badge.hidden = !(shouldShow && index === 0);
          }
        });
      };

      updateScheduledPublications();
    })();
  </script>

  <style>

    .latest-publications {
      display: grid;
      gap: 1.25rem;
      padding-top: 2.5rem;
    }

    .latest-publications-header {
      display: grid;
      grid-template-columns: minmax(120px, 0.22fr) minmax(0, 1fr);
      gap: 1rem;
      align-items: start;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
    }

    .latest-publications-header h2 {
      margin-bottom: 0.45rem;
      font-size: clamp(1.85rem, 3.4vw, 2.85rem);
    }

    .latest-publications-header p:last-child {
      max-width: 780px;
      margin: 0;
      color: var(--text-muted);
    }

    .latest-publications-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .latest-publication-card {
      display: grid;
      grid-template-rows: auto 1fr;
      gap: 0.95rem;
      padding: 1rem;
      overflow: hidden;
    }

    .latest-publication-card.is-primary {
      border-color: rgba(184, 155, 94, 0.48);
      background: linear-gradient(135deg, rgba(184, 155, 94, 0.12), rgba(255, 255, 255, 0.86));
      box-shadow: 0 18px 42px rgba(11, 31, 51, 0.12);
    }

    .latest-publication-media {
      display: block;
      color: var(--primary);
    }

    .latest-publication-media img {
      display: block;
      width: 100%;
      height: 220px;
      object-fit: contain;
      border-radius: 16px;
      border: 1px solid var(--border);
      background: var(--surface-muted);
      box-shadow: 0 14px 34px rgba(11, 31, 51, 0.12);
    }

    .latest-publication-body {
      display: grid;
      gap: 0.7rem;
      align-content: start;
    }

    .latest-publication-body h3 {
      font-size: clamp(1.25rem, 2.2vw, 1.85rem);
      line-height: 1.08;
    }

    .latest-publication-body h3 a:hover {
      color: var(--secondary);
    }

    .latest-publication-body p {
      margin: 0;
      color: var(--text-muted);
    }

    .latest-publication-body .publication-button {
      justify-self: start;
      margin-top: 0.25rem;
    }

    .publications-catalog {
      display: grid;
      gap: 3rem;
      padding-top: 2.5rem;
    }

    .publication-section {
      display: grid;
      gap: 1.15rem;
    }

    .publication-section-header {
      display: grid;
      grid-template-columns: minmax(120px, 0.22fr) minmax(0, 1fr);
      gap: 1rem;
      align-items: start;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
    }

    .publication-section-header h2 {
      margin-bottom: 0.45rem;
      font-size: clamp(1.65rem, 3vw, 2.45rem);
    }

    .publication-section-header p:last-child {
      max-width: 780px;
      margin: 0;
      color: var(--text-muted);
    }

    .publication-list {
      display: grid;
      gap: 0.95rem;
    }

    .publication-item {
      display: grid;
      grid-template-columns: 112px minmax(0, 1fr) auto;
      gap: 1rem;
      align-items: start;
      padding: 1rem;
    }

    .publication-media {
      display: block;
      width: 112px;
      min-height: 140px;
      color: var(--primary);
    }

    .publication-media img {
      display: block;
      width: 100%;
      height: auto;
      max-height: 148px;
      object-fit: contain;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--surface-muted);
      box-shadow: 0 12px 30px rgba(11, 31, 51, 0.12);
    }

    .publication-placeholder {
      display: flex;
      min-height: 112px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(184, 155, 94, 0.18), rgba(47, 72, 88, 0.08));
      text-align: center;
      box-shadow: 0 12px 30px rgba(11, 31, 51, 0.08);
    }

    .publication-placeholder strong {
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--primary);
    }

    .publication-placeholder small {
      color: var(--text-muted);
      font-weight: 800;
    }

    .publication-body {
      display: grid;
      gap: 0.6rem;
      min-width: 0;
    }

    .publication-kicker {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      align-items: center;
    }

    .publication-kicker span {
      display: inline-flex;
      align-items: center;
      min-height: 24px;
      padding: 0.2rem 0.55rem;
      border-radius: 999px;
      background: rgba(184, 155, 94, 0.12);
      color: var(--accent);
      font-size: 0.75rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .publication-body h3 {
      max-width: 720px;
      font-size: clamp(1.28rem, 2vw, 1.7rem);
      line-height: 1.05;
    }

    .publication-body h3 a:hover {
      color: var(--secondary);
    }

    .publication-body > p {
      max-width: 760px;
      margin: 0;
      color: var(--text-muted);
    }

    .publication-metadata {
      display: grid;
      grid-template-columns: max-content minmax(0, 1fr);
      gap: 0.25rem 0.75rem;
      margin: 0.2rem 0 0;
      font-size: 0.95rem;
    }

    .publication-metadata dt {
      font-weight: 900;
      color: var(--primary);
    }

    .publication-metadata dd {
      margin: 0;
      color: var(--text-muted);
    }

    .publication-action {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      align-items: stretch;
      justify-content: flex-start;
      min-width: 144px;
    }

    .publication-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      border: 1px solid var(--primary);
      padding: 0.65rem 0.9rem;
      color: var(--primary);
      font-weight: 900;
      text-align: center;
      transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
    }

    .publication-button:hover {
      background: var(--primary);
      color: white;
      transform: translateY(-1px);
    }

    @media (max-width: 760px) {
      .latest-publications-header {
        grid-template-columns: 1fr;
      }

      .latest-publications-grid {
        grid-template-columns: 1fr;
      }

      .latest-publication-media img {
        height: auto;
        max-height: 320px;
      }

      .publication-section-header {
        grid-template-columns: 1fr;
      }

      .publication-item {
        grid-template-columns: 88px minmax(0, 1fr);
      }

      .publication-media {
        width: 88px;
        min-height: 104px;
      }

      .publication-action {
        grid-column: 1 / -1;
        flex-direction: row;
        flex-wrap: wrap;
        min-width: 0;
      }
    }

    @media (max-width: 520px) {
      .publication-item {
        grid-template-columns: 1fr;
      }

      .publication-media {
        width: 100%;
        min-height: 0;
      }

      .publication-media img,
      .publication-placeholder {
        max-width: 160px;
      }
    }
  </style>
</BaseLayout>
