---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';

const pubblicazioni = await getCollection('pubblicazione');

const normalize = (value = '') => value.toLowerCase();

const categoryDefinitions = [
  {
    id: 'libri',
    title: 'Libri',
    description: 'Volumi e pubblicazioni monografiche dedicate all’analisi intelligence, ai metodi e alla cultura strategica.',
    match: (type) => normalize(type).includes('libro')
  },
  {
    id: 'progetti-editoriali',
    title: 'Progetti editoriali',
    description: 'Materiali in preparazione, progetti editoriali e linee di sviluppo future.',
    match: (type) => normalize(type).includes('progetto')
  },
  {
    id: 'paper',
    title: 'Paper e contributi dottrinali',
    description: 'Contributi pubblicati su siti istituzionali, associazioni, centri studi e piattaforme di approfondimento specialistico.',
    match: (type) => normalize(type).includes('paper') || normalize(type).includes('contributo dottrinale')
  },
  {
    id: 'articoli-online',
    title: 'Articoli e contributi online',
    description: 'Articoli, post e contributi pubblicati online, inclusi i contenuti divulgativi pubblicati su LinkedIn.',
    match: (type) => normalize(type).includes('articolo online') || normalize(type).includes('post') || normalize(type).includes('linkedin') || normalize(type).includes('contributo online')
  }
];

const usedIds = new Set();
const groups = categoryDefinitions
  .map((category) => {
    const items = pubblicazioni
      .filter((pubblicazione) => {
        if (usedIds.has(pubblicazione.id)) return false;
        return category.match(pubblicazione.data.type);
      })
      .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year || a.data.title.localeCompare(b.data.title, 'it'));

    items.forEach((item) => usedIds.add(item.id));
    return { ...category, items };
  })
  .filter((category) => category.items.length > 0);

const getActionLabel = (pubblicazione) => {
  const type = normalize(pubblicazione.data.type);
  if (type.includes('libro')) return 'Apri scheda libro';
  return 'Apri scheda';
};

const isPublisherOffline = (pubblicazione) => {
  const publisher = normalize(pubblicazione.data.publisher || '');
  return publisher.includes('alpha institute') || publisher.includes('analytica');
};

const getAvailability = (pubblicazione) => {
  if (pubblicazione.data.sourceStatus) return pubblicazione.data.sourceStatus;
  if (isPublisherOffline(pubblicazione)) return 'Sito editore non più online; PDF locale nella scheda';
  return '';
};
---
<BaseLayout title="Pubblicazioni — Lab4Int - Intelligence Analysis Laboratory" description="Libri, paper, contributi dottrinali e articoli online.">
  <Hero
    eyebrow="Pubblicazioni"
    title="Libri, paper e contributi per la cultura dell’analisi"
    description="Una raccolta ordinata di libri, progetti editoriali, paper dottrinali e contributi online dedicati all’intelligence analysis."
    primaryHref="/contatti/"
    primaryLabel="Richiedi informazioni"
    secondaryHref="/didattica/"
    secondaryLabel="Scopri la didattica"
  />

  <section class="page-section publications-catalog">
    {groups.map((group) => (
      <section class="publication-section" aria-labelledby={`publication-section-${group.id}`}>
        <header class="publication-section-header">
          <p class="eyebrow">{group.items.length} {group.items.length === 1 ? 'elemento' : 'elementi'}</p>
          <div>
            <h2 id={`publication-section-${group.id}`}>{group.title}</h2>
            <p>{group.description}</p>
          </div>
        </header>

        <div class="publication-list">
          {group.items.map((pubblicazione) => {
            const availability = getAvailability(pubblicazione);
            return (
              <article class="publication-item panel">
                <a class="publication-media" href={`/pubblicazioni/${pubblicazione.id}/`} aria-label={`Apri la scheda ${pubblicazione.data.title}`}>
                  {pubblicazione.data.cover ? (
                    <img src={pubblicazione.data.cover} alt={`Copertina di ${pubblicazione.data.title}`} loading="lazy" decoding="async" />
                  ) : (
                    <span class="publication-placeholder" aria-hidden="true">
                      <strong>{pubblicazione.data.type}</strong>
                      <small>{pubblicazione.data.year}</small>
                    </span>
                  )}
                </a>

                <div class="publication-body">
                  <div class="publication-kicker">
                    <span>{pubblicazione.data.type}</span>
                    <span>{pubblicazione.data.year}</span>
                    {pubblicazione.data.featured && <span>In evidenza</span>}
                    {pubblicazione.data.pdfUrl && <span>PDF</span>}
                  </div>

                  <h3><a href={`/pubblicazioni/${pubblicazione.id}/`}>{pubblicazione.data.title}</a></h3>
                  <p>{pubblicazione.data.description}</p>

                  <dl class="publication-metadata">
                    {pubblicazione.data.publisher && <><dt>Sede/Editore</dt><dd>{pubblicazione.data.publisher}</dd></>}
                    {pubblicazione.data.theme && <><dt>Tema</dt><dd>{pubblicazione.data.theme}</dd></>}
                    {availability && <><dt>Disponibilità</dt><dd>{availability}</dd></>}
                    {pubblicazione.data.license && <><dt>Licenza</dt><dd>{pubblicazione.data.license}</dd></>}
                    {pubblicazione.data.isbnPrint && <><dt>ISBN cartaceo</dt><dd>{pubblicazione.data.isbnPrint}</dd></>}
                    {pubblicazione.data.isbnEbook && <><dt>ISBN ebook</dt><dd>{pubblicazione.data.isbnEbook}</dd></>}
                  </dl>
                </div>

                <div class="publication-action">
                  <a class="publication-button" href={`/pubblicazioni/${pubblicazione.id}/`}>{getActionLabel(pubblicazione)}</a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </section>

  <style>
    .publications-catalog {
      display: grid;
      gap: 3rem;
      padding-top: 2.5rem;
    }

    .publication-section {
      display: grid;
      gap: 1.15rem;
    }

    .publication-section-header {
      display: grid;
      grid-template-columns: minmax(120px, 0.22fr) minmax(0, 1fr);
      gap: 1rem;
      align-items: start;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
    }

    .publication-section-header h2 {
      margin-bottom: 0.45rem;
      font-size: clamp(1.65rem, 3vw, 2.45rem);
    }

    .publication-section-header p:last-child {
      max-width: 780px;
      margin: 0;
      color: var(--text-muted);
    }

    .publication-list {
      display: grid;
      gap: 0.95rem;
    }

    .publication-item {
      display: grid;
      grid-template-columns: 112px minmax(0, 1fr) auto;
      gap: 1rem;
      align-items: start;
      padding: 1rem;
    }

    .publication-media {
      display: block;
      width: 112px;
      min-height: 140px;
      color: var(--primary);
    }

    .publication-media img {
      display: block;
      width: 100%;
      height: auto;
      max-height: 148px;
      object-fit: contain;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--surface-muted);
      box-shadow: 0 12px 30px rgba(11, 31, 51, 0.12);
    }

    .publication-placeholder {
      display: flex;
      min-height: 112px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(184, 155, 94, 0.18), rgba(47, 72, 88, 0.08));
      text-align: center;
      box-shadow: 0 12px 30px rgba(11, 31, 51, 0.08);
    }

    .publication-placeholder strong {
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--primary);
    }

    .publication-placeholder small {
      color: var(--text-muted);
      font-weight: 800;
    }

    .publication-body {
      display: grid;
      gap: 0.6rem;
      min-width: 0;
    }

    .publication-kicker {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      align-items: center;
    }

    .publication-kicker span {
      display: inline-flex;
      align-items: center;
      min-height: 24px;
      padding: 0.2rem 0.55rem;
      border-radius: 999px;
      background: rgba(184, 155, 94, 0.12);
      color: var(--accent);
      font-size: 0.75rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .publication-body h3 {
      max-width: 720px;
      font-size: clamp(1.28rem, 2vw, 1.7rem);
      line-height: 1.05;
    }

    .publication-body h3 a:hover {
      color: var(--secondary);
    }

    .publication-body > p {
      max-width: 760px;
      margin: 0;
      color: var(--text-muted);
    }

    .publication-metadata {
      display: grid;
      grid-template-columns: max-content minmax(0, 1fr);
      gap: 0.25rem 0.75rem;
      margin: 0.2rem 0 0;
      font-size: 0.95rem;
    }

    .publication-metadata dt {
      font-weight: 900;
      color: var(--primary);
    }

    .publication-metadata dd {
      margin: 0;
      color: var(--text-muted);
    }

    .publication-action {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      align-items: stretch;
      justify-content: flex-start;
      min-width: 144px;
    }

    .publication-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      border: 1px solid var(--primary);
      padding: 0.65rem 0.9rem;
      color: var(--primary);
      font-weight: 900;
      text-align: center;
      transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
    }

    .publication-button:hover {
      background: var(--primary);
      color: white;
      transform: translateY(-1px);
    }

    @media (max-width: 760px) {
      .publication-section-header {
        grid-template-columns: 1fr;
      }

      .publication-item {
        grid-template-columns: 88px minmax(0, 1fr);
      }

      .publication-media {
        width: 88px;
        min-height: 104px;
      }

      .publication-action {
        grid-column: 1 / -1;
        flex-direction: row;
        flex-wrap: wrap;
        min-width: 0;
      }
    }

    @media (max-width: 520px) {
      .publication-item {
        grid-template-columns: 1fr;
      }

      .publication-media {
        width: 100%;
        min-height: 0;
      }

      .publication-media img,
      .publication-placeholder {
        max-width: 160px;
      }
    }
  </style>
</BaseLayout>
