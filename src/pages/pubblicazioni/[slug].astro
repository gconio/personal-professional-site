---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const pubblicazioni = await getCollection('pubblicazione');
  return pubblicazioni.map((pubblicazione) => ({ params: { slug: pubblicazione.id }, props: { pubblicazione } }));
}

const { pubblicazione } = Astro.props;
const { Content } = await render(pubblicazione);
const hasFacts = pubblicazione.data.publisher || pubblicazione.data.theme || pubblicazione.data.isbnPrint || pubblicazione.data.isbnEbook || pubblicazione.data.link;
const linkLabel = pubblicazione.data.type.toLowerCase().includes('libro') ? 'Acquista su Youcanprint' : 'Leggi alla fonte originale';
const isManuale = pubblicazione.id === 'manuale-analisi-intelligence' || pubblicazione.data.title.toLowerCase().includes('manuale per l’analisi intelligence') || pubblicazione.data.title.toLowerCase().includes("manuale per l'analisi intelligence");
---
<BaseLayout title={`${pubblicazione.data.title} — Pubblicazioni`} description={pubblicazione.data.description}>
  <article class="article-page publication-page">
    <header class="article-header">
      <p class="eyebrow">Pubblicazione</p>
      <h1>{pubblicazione.data.title}</h1>
      <p class="article-meta">{pubblicazione.data.type} · {pubblicazione.data.year}</p>
    </header>

    {(pubblicazione.data.cover || hasFacts) && (
      <section class="publication-detail-grid" aria-label="Dati principali della pubblicazione">
        {pubblicazione.data.cover && (
          <aside class="panel publication-media-panel">
            <img
              src={pubblicazione.data.cover}
              alt={`Copertina di ${pubblicazione.data.title}`}
              class="publication-detail-cover"
              loading="eager"
              decoding="async"
            />
            {pubblicazione.data.formatsImage && (
              <img
                src={pubblicazione.data.formatsImage}
                alt="Formati disponibili del Manuale per l’analisi intelligence"
                class="publication-formats-image"
                loading="lazy"
                decoding="async"
              />
            )}
          </aside>
        )}

        {hasFacts && (
          <aside class="panel publication-facts">
            <h2>Dati editoriali</h2>
            <dl>
              {pubblicazione.data.publisher && <dt>Editore</dt>}
              {pubblicazione.data.publisher && <dd>{pubblicazione.data.publisher}</dd>}
              <dt>Anno</dt><dd>{pubblicazione.data.year}</dd>
              {pubblicazione.data.theme && <dt>Tema</dt>}
              {pubblicazione.data.theme && <dd>{pubblicazione.data.theme}</dd>}
              {pubblicazione.data.isbnPrint && <dt>ISBN cartaceo</dt>}
                {pubblicazione.data.isbnPrint && <dd>{pubblicazione.data.isbnPrint}</dd>}
              {pubblicazione.data.isbnEbook && <dt>ISBN ebook</dt>}
                {pubblicazione.data.isbnEbook && <dd>{pubblicazione.data.isbnEbook}</dd>}
            </dl>
            {pubblicazione.data.link && (
              <a class="button primary" href={pubblicazione.data.link} target="_blank" rel="noopener noreferrer">{linkLabel}</a>
            )}
          </aside>
        )}
      </section>
    )}

    <div class="prose">
      <Content />
    </div>

    {isManuale && (
      <section class="panel reader-feedback-callout" aria-labelledby="reader-feedback-title">
        <div>
          <p class="card-meta">Lettori</p>
          <h2 id="reader-feedback-title">Commenti sul Manuale</h2>
          <p>
            Hai letto il volume o vuoi condividere una riflessione sul tema dell’analisi intelligence?
            Puoi inviare un commento, una breve recensione o un feedback. I contributi più significativi
            potranno essere pubblicati previa moderazione.
          </p>
        </div>
        <a class="button primary" href="/commenti-manuale/">Lascia un commento</a>
      </section>
    )}

    <style>
      .reader-feedback-callout {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        margin-top: 2rem;
      }

      .reader-feedback-callout h2 {
        font-size: clamp(1.8rem, 3vw, 2.35rem);
        margin-bottom: 0.65rem;
      }

      .reader-feedback-callout p {
        color: var(--text-muted);
        margin-bottom: 0;
      }

      @media (max-width: 880px) {
        .reader-feedback-callout {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>

  </article>
</BaseLayout>
