---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const pubblicazioni = await getCollection('pubblicazione');
  return pubblicazioni.map((pubblicazione) => ({ params: { slug: pubblicazione.id }, props: { pubblicazione } }));
}

const { pubblicazione } = Astro.props;
const { Content: PublicationContent } = await render(pubblicazione);

const visibleFrom = pubblicazione.data.visibleFrom || '';
const isScheduledPublication = Boolean(visibleFrom);
const formatDateOnlyInRome = (value) => {
  const [year, month, day] = value.split('-').map(Number);
  const safeDate = new Date(Date.UTC(year, month - 1, day, 12));

  return new Intl.DateTimeFormat('it-IT', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
    timeZone: 'Europe/Rome'
  }).format(safeDate);
};
const visibleFromLabel = visibleFrom ? formatDateOnlyInRome(visibleFrom) : '';

const hasFacts = pubblicazione.data.publisher || pubblicazione.data.theme || pubblicazione.data.isbnPrint || pubblicazione.data.isbnEbook || pubblicazione.data.link || pubblicazione.data.pdfUrl || pubblicazione.data.sourceStatus || pubblicazione.data.license;
const publisherName = (pubblicazione.data.publisher || '').toLowerCase();
const isPublisherOffline = publisherName.includes('alpha institute') || publisherName.includes('analytica');
const isAiaig = publisherName.includes('associazione italiana analisti di intelligence') || publisherName.includes('aiaig');
const linkLabel = pubblicazione.data.type.toLowerCase().includes('libro')
  ? 'Acquista su Youcanprint'
  : isAiaig
    ? 'Vai al sito AIAIG'
    : 'Leggi alla fonte originale';
const isManuale = pubblicazione.id === 'manuale-analisi-intelligence' || pubblicazione.data.title.toLowerCase().includes('manuale per l’analisi intelligence') || pubblicazione.data.title.toLowerCase().includes("manuale per l'analisi intelligence");
const availability = pubblicazione.data.sourceStatus || (isPublisherOffline ? 'Il sito dell’editore non è più online; il PDF è quindi reso disponibile in download locale.' : '');
const manualPreviewIndexPdf = pubblicazione.data.previewIndexPdf;
const manualPreviewSamplePdf = pubblicazione.data.previewSamplePdf;
const hasManualPreview = isManuale && (manualPreviewIndexPdf || manualPreviewSamplePdf);
const publicationCtaTitle = isManuale
  ? 'Usare il Manuale in un corso, evento o percorso formativo'
  : 'Approfondire o discutere questa pubblicazione';
const publicationCtaText = isManuale
  ? 'Il volume può essere presentato in contesti universitari, seminari specialistici, incontri culturali o percorsi di formazione dedicati all’analisi intelligence.'
  : 'Per commenti, richieste di approfondimento, citazioni, presentazioni o iniziative collegate a questo contributo è possibile inviare una richiesta diretta.';

const formatCommentDate = (date: Date) =>
  new Intl.DateTimeFormat('it-IT', {
    day: '2-digit',
    month: 'long',
    year: 'numeric'
  }).format(date);

const commentiManuale = isManuale
  ? (await getCollection('commentiManuale', ({ data }) => data.published && data.consent))
      .sort((a, b) => {
        const dateDelta = b.data.date.getTime() - a.data.date.getTime();
        if (dateDelta !== 0) return dateDelta;
        return b.id.localeCompare(a.id, 'it');
      })
  : [];

const commentiManualeRenderizzati = await Promise.all(
  commentiManuale.map(async (commento) => {
    const { Content: CommentContent } = await render(commento);
    return { commento, CommentContent };
  })
);

const siteUrl = 'https://giovanni.conio.lab4int.com';
const pageUrl = `${siteUrl}/pubblicazioni/${pubblicazione.id}/`;
const pageTitle = `${pubblicazione.data.title} — Pubblicazioni | Lab4Int`;
const publicationType = pubblicazione.data.type.toLowerCase();
const isBook = isManuale || publicationType.includes('libro') || pubblicazione.data.isbnPrint || pubblicazione.data.isbnEbook;
const isArticle = publicationType.includes('articolo') || publicationType.includes('paper') || publicationType.includes('contributo');
const publicationSchemaType = isBook ? 'Book' : isArticle ? 'Article' : 'CreativeWork';
const publicationImage = pubblicazione.data.cover || pubblicazione.data.formatsImage || '/images/logo-gc.png';
const publicationStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': publicationSchemaType,
    name: pubblicazione.data.title,
    headline: isArticle ? pubblicazione.data.title : undefined,
    description: pubblicazione.data.description,
    url: pageUrl,
    image: publicationImage.startsWith('http') ? publicationImage : `${siteUrl}${publicationImage}`,
    inLanguage: 'it-IT',
    datePublished: `${pubblicazione.data.year}`,
    author: {
      '@type': 'Person',
      name: 'Giovanni CONIO',
      url: `${siteUrl}/chi-sono/`
    },
    publisher: {
      '@type': 'Organization',
      name: pubblicazione.data.publisher || 'Lab4Int - Intelligence Analysis Laboratory',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/images/logo-gc.png`
      }
    },
    isbn: pubblicazione.data.isbnPrint || pubblicazione.data.isbnEbook || undefined,
    bookFormat: isBook ? 'https://schema.org/Paperback' : undefined,
    keywords: pubblicazione.data.tags?.join(', ') || pubblicazione.data.theme || undefined,
    sameAs: pubblicazione.data.link || undefined,
    encoding: pubblicazione.data.pdfUrl
      ? {
          '@type': 'MediaObject',
          contentUrl: pubblicazione.data.pdfUrl.startsWith('http') ? pubblicazione.data.pdfUrl : `${siteUrl}${pubblicazione.data.pdfUrl}`,
          encodingFormat: 'application/pdf'
        }
      : undefined
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Pubblicazioni', item: `${siteUrl}/pubblicazioni/` },
      { '@type': 'ListItem', position: 3, name: pubblicazione.data.title, item: pageUrl }
    ]
  }
];
---
<BaseLayout
  title={pageTitle}
  description={pubblicazione.data.description}
  image={publicationImage}
  type={isArticle ? 'article' : 'book'}
  structuredData={publicationStructuredData}
>
  <article class="article-page publication-page">
    <header class="article-header">
      <p class="eyebrow">Pubblicazione</p>
      <h1>{pubblicazione.data.title}</h1>
      <p class="article-meta">{pubblicazione.data.type} · {pubblicazione.data.year}</p>
    </header>

    {isScheduledPublication && (
      <section
        class="panel scheduled-publication-notice"
        data-scheduled-notice
        data-visible-from={visibleFrom}
        aria-live="polite"
      >
        <p class="card-meta">Pubblicazione programmata</p>
        <h2>Documento disponibile dal {visibleFromLabel}</h2>
        <p>
          La scheda è già predisposta nel sito, ma il contenuto dell’articolo e il PDF saranno mostrati automaticamente
          dalla data programmata.
        </p>
      </section>
    )}

    <div
      class="scheduled-publication-content"
      data-scheduled-content
      data-visible-from={visibleFrom || undefined}
      hidden={isScheduledPublication}
    >

    {(pubblicazione.data.cover || hasFacts) && (
      <section class="publication-detail-grid" aria-label="Dati principali della pubblicazione">
        {pubblicazione.data.cover && (
          <aside class="panel publication-media-panel">
            <img
              src={pubblicazione.data.cover}
              alt={`Copertina di ${pubblicazione.data.title}`}
              class="publication-detail-cover"
              loading="eager"
              decoding="async"
            />
          </aside>
        )}

        {hasFacts && (
          <aside class="panel publication-facts">
            <h2>Dati editoriali</h2>
            <dl>
              {pubblicazione.data.publisher && <dt>Editore</dt>}
              {pubblicazione.data.publisher && <dd>{pubblicazione.data.publisher}</dd>}
              <dt>Anno</dt><dd>{pubblicazione.data.year}</dd>
              {pubblicazione.data.theme && <dt>Tema</dt>}
              {pubblicazione.data.theme && <dd>{pubblicazione.data.theme}</dd>}
              {pubblicazione.data.license && <dt>Licenza</dt>}
              {pubblicazione.data.license && <dd>{pubblicazione.data.license}</dd>}
              {pubblicazione.data.isbnPrint && <dt>ISBN cartaceo</dt>}
              {pubblicazione.data.isbnPrint && <dd>{pubblicazione.data.isbnPrint}</dd>}
              {pubblicazione.data.isbnEbook && <dt>ISBN ebook</dt>}
              {pubblicazione.data.isbnEbook && <dd>{pubblicazione.data.isbnEbook}</dd>}
              {pubblicazione.data.pdfUrl && <dt>PDF</dt>}
              {pubblicazione.data.pdfUrl && <dd>Download disponibile</dd>}
              {availability && <dt>Disponibilità</dt>}
              {availability && <dd>{availability}</dd>}
            </dl>
            {pubblicazione.data.link && (
              <a class="button primary" href={pubblicazione.data.link} target="_blank" rel="noopener noreferrer">{linkLabel}</a>
            )}
            {pubblicazione.data.pdfUrl && (
              <a class="button secondary" href={pubblicazione.data.pdfUrl} download>Scarica PDF</a>
            )}
          </aside>
        )}
      </section>
    )}

    <div class="prose">
      <PublicationContent />
    </div>


    <section class="panel publication-cta" aria-labelledby="publication-cta-title">
      <div>
        <p class="card-meta">{isManuale ? 'Manuale' : 'Approfondimento'}</p>
        <h2 id="publication-cta-title">{publicationCtaTitle}</h2>
        <p>{publicationCtaText}</p>
      </div>
      <div class="publication-cta-actions">
        {isManuale && pubblicazione.data.link && (
          <a class="button primary" href={pubblicazione.data.link} target="_blank" rel="noopener noreferrer">Acquista il volume</a>
        )}
        {isManuale && hasManualPreview && (
          <a class="button secondary" href="#estratto-manuale">Sfoglia l’estratto</a>
        )}
        {isManuale && (
          <a class="button secondary" href="/commenti-manuale/">Lascia un commento</a>
        )}
        <a class:list={['button', isManuale ? 'secondary' : 'primary']} href="/contatti/">
          {isManuale ? 'Richiedi una presentazione' : 'Invia una richiesta'}
        </a>
      </div>
    </section>

    {hasManualPreview && (
      <section class="manual-preview-section" id="estratto-manuale" aria-labelledby="manual-preview-title">
        <div class="section-heading manual-preview-heading">
          <p class="eyebrow">Estratto dimostrativo</p>
          <h2 id="manual-preview-title">Sfoglia un estratto del Manuale</h2>
          <p>
            Consulta l’indice del volume e alcune pagine selezionate. L’estratto è pubblicato a solo scopo informativo
            e non sostituisce l’edizione completa disponibile presso l’editore.
          </p>
        </div>

        <div class="manual-preview-grid">
          {manualPreviewIndexPdf && (
            <article class="panel manual-preview-card manual-preview-card-index">
              <header>
                <p class="card-meta">Da visualizzare per primo</p>
                <h3>Indice del volume</h3>
                <p>La struttura completa del Manuale: parti, capitoli, sezioni e bibliografia.</p>
              </header>
              <iframe
                class="manual-pdf-viewer"
                src={`${manualPreviewIndexPdf}#toolbar=1&navpanes=0&view=FitH`}
                title="Indice del Manuale per l’analisi intelligence"
                loading="lazy"
              ></iframe>
              <a class="button secondary" href={manualPreviewIndexPdf} target="_blank" rel="noopener noreferrer">Apri l’indice in nuova scheda</a>
            </article>
          )}

          {manualPreviewSamplePdf && (
            <article class="panel manual-preview-card">
              <header>
                <p class="card-meta">Pagine selezionate</p>
                <h3>Estratto di lettura</h3>
                <p>Alcune pagine dimostrative tratte dal volume, incluse prefazione, introduzione e sezioni iniziali.</p>
              </header>
              <iframe
                class="manual-pdf-viewer"
                src={`${manualPreviewSamplePdf}#toolbar=1&navpanes=0&view=FitH`}
                title="Estratto del Manuale per l’analisi intelligence"
                loading="lazy"
              ></iframe>
              <a class="button secondary" href={manualPreviewSamplePdf} target="_blank" rel="noopener noreferrer">Apri l’estratto in nuova scheda</a>
            </article>
          )}
        </div>
      </section>
    )}

    {isManuale && (
      <section class="panel reader-feedback-callout" aria-labelledby="reader-feedback-title">
        <div>
          <p class="card-meta">Lettori</p>
          <h2 id="reader-feedback-title">Commenti sul Manuale</h2>
          <p>
            Hai letto il volume o vuoi condividere una riflessione sul tema dell’analisi intelligence?
            Puoi inviare un commento, una breve recensione o un feedback. I contributi più significativi
            potranno essere pubblicati previa moderazione.
          </p>
        </div>
        <a class="button primary" href="/commenti-manuale/">Lascia un commento</a>
      </section>
    )}

    {isManuale && commentiManualeRenderizzati.length > 0 && (
      <section class="reader-comments-section" aria-labelledby="reader-comments-title">
        <div class="section-heading">
          <p class="eyebrow">Commenti dei lettori</p>
          <h2 id="reader-comments-title">Feedback pubblicati</h2>
          <p>
            Una selezione di commenti e riflessioni ricevuti sul volume, pubblicati previa moderazione e consenso.
          </p>
        </div>

        <div class="reader-comments-grid">
          {commentiManualeRenderizzati.map(({ commento, CommentContent }) => (
            <article class:list={['panel', 'reader-comment-card', { featured: commento.data.featured }]}>
              <div class="reader-comment-content">
                <CommentContent />
              </div>
              <footer class="reader-comment-footer">
                <strong>{commento.data.name}</strong>
                <span>
                  {commento.data.role ? `${commento.data.role} · ` : ''}
                  {formatCommentDate(commento.data.date)}
                </span>
              </footer>
            </article>
          ))}
        </div>
      </section>
    )}

    </div>

    <script is:inline>
      (() => {
        const content = document.querySelector('[data-scheduled-content]');
        const notice = document.querySelector('[data-scheduled-notice]');
        const visibleFromValue = content?.getAttribute('data-visible-from');

        if (!content || !visibleFromValue) return;

        const parts = new Intl.DateTimeFormat('en', {
          timeZone: 'Europe/Rome',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit'
        }).formatToParts(new Date());
        const values = Object.fromEntries(
          parts
            .filter(({ type }) => type !== 'literal')
            .map(({ type, value }) => [type, value])
        );
        const todayInRome = `${values.year}-${values.month}-${values.day}`;

        if (todayInRome >= visibleFromValue) {
          content.hidden = false;
          if (notice) notice.hidden = true;
        } else {
          content.hidden = true;
          if (notice) notice.hidden = false;
        }
      })();
    </script>

    <style>


      .publication-cta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.25rem;
        margin-top: 2.5rem;
      }

      .publication-cta h2 {
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        margin-bottom: 0.55rem;
      }

      .publication-cta p {
        max-width: 760px;
        margin: 0;
        color: var(--text-muted);
      }

      .publication-cta-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        justify-content: flex-end;
      }

      @media (max-width: 880px) {
        .publication-cta {
          align-items: flex-start;
          flex-direction: column;
        }

        .publication-cta-actions {
          justify-content: flex-start;
        }
      }

      .manual-preview-section {
        margin-top: 3rem;
      }

      .manual-preview-heading {
        margin-bottom: 1.15rem;
      }

      .manual-preview-heading p:last-child {
        max-width: 840px;
        color: var(--text-muted);
      }

      .manual-preview-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        align-items: start;
      }

      .manual-preview-card {
        display: grid;
        gap: 1rem;
        padding: 1rem;
      }

      .manual-preview-card header {
        display: grid;
        gap: 0.35rem;
      }

      .manual-preview-card h3 {
        font-size: clamp(1.35rem, 2vw, 1.8rem);
      }

      .manual-preview-card p {
        color: var(--text-muted);
        margin: 0;
      }

      .manual-preview-card-index {
        border-left: 4px solid var(--accent);
      }

      .manual-pdf-viewer {
        width: 100%;
        min-height: 620px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: var(--surface-muted);
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.4);
      }

      @media (max-width: 980px) {
        .manual-preview-grid {
          grid-template-columns: 1fr;
        }

        .manual-pdf-viewer {
          min-height: 560px;
        }
      }

      @media (max-width: 620px) {
        .manual-pdf-viewer {
          min-height: 480px;
        }
      }

      .reader-feedback-callout {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        margin-top: 2rem;
      }

      .reader-feedback-callout h2,
      .reader-comments-section h2 {
        font-size: clamp(1.8rem, 3vw, 2.35rem);
        margin-bottom: 0.65rem;
      }

      .reader-feedback-callout p,
      .reader-comments-section .section-heading p {
        color: var(--text-muted);
        margin-bottom: 0;
      }

      .reader-comments-section {
        margin-top: 3rem;
      }

      .reader-comments-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.15rem;
      }

      .reader-comment-card {
        width: 100%;
        display: grid;
        gap: 1.1rem;
        border-left: 4px solid var(--accent);
      }

      .reader-comment-card.featured {
        background: linear-gradient(180deg, rgba(184, 155, 94, 0.10), var(--surface));
      }

      .reader-comment-content {
        color: var(--text);
        font-size: 1.02rem;
      }

      .reader-comment-content p:first-child {
        margin-top: 0;
      }

      .reader-comment-content p:last-child {
        margin-bottom: 0;
      }

      .reader-comment-footer {
        margin-top: 0.25rem;
        padding-top: 0.95rem;
        border-top: 1px solid var(--border);
        display: grid;
        gap: 0.2rem;
      }

      .reader-comment-footer strong {
        color: var(--primary);
      }

      .reader-comment-footer span {
        color: var(--text-muted);
        font-size: 0.95rem;
      }

      @media (max-width: 880px) {
        .reader-feedback-callout {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>

  </article>
</BaseLayout>
