---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';

const risorse = await getCollection('risorsa');

const sortResources = (items) =>
  items.sort((a, b) =>
    Number(b.data.featured) - Number(a.data.featured)
    || Number(a.data.order ?? 999) - Number(b.data.order ?? 999)
    || a.data.title.localeCompare(b.data.title, 'it')
  );

const hasCategory = (risorsa, categories) => categories.includes(risorsa.data.category);
const hasType = (risorsa, terms) => {
  const type = String(risorsa.data.type ?? '').toLowerCase();
  return terms.some((term) => type.includes(term.toLowerCase()));
};

const categoryDefinitions = [
  {
    id: 'in-evidenza',
    title: 'In evidenza',
    description: 'Risorse prioritarie e trasversali per metodo, formazione e pratica analitica.',
    open: true,
    match: (risorsa) => Boolean(risorsa.data.featured)
  },
  {
    id: 'intelligence-analysis-sats',
    title: 'Intelligence Analysis / SATs',
    description: 'Metodo intelligence, tecniche analitiche strutturate, bias cognitivi, tradecraft, standard analitici e qualità del giudizio.',
    open: false,
    match: (risorsa) => hasCategory(risorsa, [
      'Fondamenti di intelligence',
      'Analisi intelligence e SAT'
    ])
  },
  {
    id: 'osint-tools',
    title: 'OSINT Tools',
    description: 'Toolkit, directory operative, laboratori e strumenti per ricerca, verifica, geolocalizzazione, archiviazione e analisi da fonti aperte.',
    open: false,
    match: (risorsa) => hasCategory(risorsa, [
      'OSINT e ambiente informativo'
    ])
  },
  {
    id: 'think-tank-centri-studi',
    title: 'Think tank e centri studi',
    description: 'Istituti, osservatori, centri di ricerca e piattaforme di analisi su geopolitica, sicurezza internazionale e cultura strategica.',
    open: false,
    match: (risorsa) =>
      hasCategory(risorsa, ['Geopolitica e sicurezza internazionale'])
      || hasType(risorsa, ['think tank', 'centro studi'])
  },
  {
    id: 'manuali-formazione-dataset',
    title: 'Manuali, formazione e dataset',
    description: 'Manuali, corsi, scuole, syllabus, report, archivi, dataset e materiali utili per studio, didattica o esercitazioni.',
    open: false,
    match: (risorsa) =>
      hasCategory(risorsa, [
        'Studiare intelligence',
        'Cyber, tecnologia e minacce digitali',
        'Disinformazione, influenza e comunicazione strategica'
      ])
      || hasType(risorsa, ['libro', 'manuale', 'documento', 'scuola', 'formazione', 'archivio', 'report', 'dataset'])
  }
];

const groups = categoryDefinitions
  .map((category) => {
    const items = sortResources(risorse.filter(category.match));
    return { ...category, items };
  })
  .filter((category) => category.items.length > 0);

const getMeta = (risorsa) => [
  risorsa.data.type,
  risorsa.data.level,
  risorsa.data.language,
  risorsa.data.year ? String(risorsa.data.year) : ''
].filter(Boolean).join(' · ');

const getCategoryLabel = (risorsa) => {
  if (risorsa.data.featured) return 'In evidenza';
  return risorsa.data.category;
};
---
<BaseLayout title="Risorse consigliate — Lab4Int - Intelligence Analysis Laboratory" description="Bibliografia ragionata, siti, report, toolkit e risorse utili per approfondire intelligence analysis, OSINT, geopolitica, cyber e disinformazione.">
  <Hero
    eyebrow="Risorse consigliate"
    title="Letture, siti e strumenti per approfondire l’intelligence"
    description="Una selezione ragionata di testi, archivi, toolkit, report e siti utili per orientarsi nello studio dell’intelligence, dell’analisi strategica e delle minacce contemporanee."
    primaryHref="/pubblicazioni/"
    primaryLabel="Consulta le pubblicazioni"
    secondaryHref="/contatti/"
    secondaryLabel="Suggerisci una risorsa"
  />

  <section class="page-section resources-intro compact-section">
    <div class="panel">
      <p class="eyebrow">Criterio editoriale</p>
      <h2>Una selezione non esaustiva, ma ragionata</h2>
      <p>
        Questa pagina non intende sostituire una bibliografia accademica completa. Raccoglie risorse selezionate per utilità formativa, qualità metodologica e rilevanza pratica per chi studia o insegna intelligence analysis, geopolitica, OSINT, sicurezza e crisis management.
      </p>
    </div>
  </section>

  <section class="page-section resources-catalog" aria-label="Catalogo risorse">
    {groups.map((group) => (
      <details class="resource-section panel" open={group.open}>
        <summary class="resource-section-header">
          <div class="resource-section-count">
            <p class="eyebrow">{group.items.length} {group.items.length === 1 ? 'risorsa' : 'risorse'}</p>
          </div>
          <div class="resource-section-title">
            <h2 id={`resource-section-${group.id}`}>{group.title}</h2>
            <p>{group.description}</p>
          </div>
        </summary>

        <div class="resource-list" aria-labelledby={`resource-section-${group.id}`}>
          {group.items.map((risorsa) => (
            <article class="resource-card">
              <div class="resource-card-main">
                <div class="resource-kicker">
                  <span>{getMeta(risorsa)}</span>
                  {risorsa.data.featured && <span>Essenziale</span>}
                  <span>{getCategoryLabel(risorsa)}</span>
                </div>

                <h3>{risorsa.data.title}</h3>

                {(risorsa.data.author || risorsa.data.institution) && (
                  <p class="resource-byline">
                    {risorsa.data.author && <span>{risorsa.data.author}</span>}
                    {risorsa.data.author && risorsa.data.institution && <span> · </span>}
                    {risorsa.data.institution && <span>{risorsa.data.institution}</span>}
                  </p>
                )}

                <p>{risorsa.data.description}</p>

                {risorsa.data.tags.length > 0 && (
                  <div class="resource-tags" aria-label="Temi della risorsa">
                    {risorsa.data.tags.map((tag) => <span>{tag}</span>)}
                  </div>
                )}
              </div>

              <div class="resource-card-action">
                {risorsa.data.link ? (
                  <a class="resource-button" href={risorsa.data.link} target="_blank" rel="noopener noreferrer">Apri risorsa</a>
                ) : (
                  <span class="resource-note">Riferimento bibliografico</span>
                )}
              </div>
            </article>
          ))}
        </div>
      </details>
    ))}
  </section>

  <section class="page-section compact-section">
    <div class="panel resources-cta">
      <div>
        <p class="card-meta">Segnalazioni</p>
        <h2>Conosci una risorsa utile da aggiungere?</h2>
        <p>
          Puoi segnalare testi, report, toolkit, archivi, centri studi o percorsi formativi
          pertinenti a intelligence analysis, OSINT, geopolitica, cyber, disinformazione e cultura strategica.
        </p>
      </div>
      <div class="resources-cta-actions">
        <a class="button primary" href="/contatti/">Suggerisci una risorsa</a>
        <a class="button secondary" href="/pubblicazioni/">Consulta le pubblicazioni</a>
      </div>
    </div>
  </section>

  <style>

    .resources-cta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.25rem;
    }

    .resources-cta h2 {
      font-size: clamp(1.55rem, 3vw, 2.15rem);
      margin-bottom: 0.55rem;
    }

    .resources-cta p {
      max-width: 780px;
      margin: 0;
      color: var(--text-muted);
    }

    .resources-cta-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      justify-content: flex-end;
    }

    @media (max-width: 860px) {
      .resources-cta {
        align-items: flex-start;
        flex-direction: column;
      }

      .resources-cta-actions {
        justify-content: flex-start;
      }
    }

    .resources-intro {
      padding-top: 2rem;
      padding-bottom: 1rem;
    }

    .resources-intro .panel {
      display: grid;
      gap: 0.7rem;
    }

    .resources-intro h2 {
      font-size: clamp(1.65rem, 3vw, 2.35rem);
    }

    .resources-intro p:last-child {
      max-width: 900px;
      margin: 0;
      color: var(--text-muted);
    }

    .resources-catalog {
      display: grid;
      gap: 1rem;
      padding-top: 2.5rem;
    }

    .resource-section {
      display: grid;
      gap: 0;
      padding: 0;
      overflow: hidden;
    }

    .resource-section summary {
      list-style: none;
    }

    .resource-section summary::-webkit-details-marker {
      display: none;
    }

    .resource-section-header {
      position: relative;
      display: grid;
      grid-template-columns: minmax(120px, 0.22fr) minmax(0, 1fr);
      gap: 1rem;
      align-items: start;
      padding: 1.25rem 4rem 1.25rem 1.35rem;
      cursor: pointer;
      border-bottom: 1px solid transparent;
    }

    .resource-section[open] .resource-section-header {
      border-bottom-color: var(--border);
    }

    .resource-section-header::after {
      content: "+";
      position: absolute;
      top: 50%;
      right: 1.35rem;
      transform: translateY(-50%);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--surface-muted);
      color: var(--primary);
      font-size: 1.35rem;
      font-weight: 900;
      line-height: 1;
    }

    .resource-section[open] .resource-section-header::after {
      content: "−";
    }

    .resource-section-header h2 {
      margin-bottom: 0.45rem;
      font-size: clamp(1.55rem, 3vw, 2.25rem);
    }

    .resource-section-header p:last-child {
      max-width: 820px;
      margin: 0;
      color: var(--text-muted);
    }

    .resource-list {
      display: grid;
      gap: 0.95rem;
      padding: 1.15rem;
    }

    .resource-card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1.25rem;
      align-items: start;
      padding: 1.15rem;
      border: 1px solid var(--border);
      border-radius: calc(var(--radius) - 4px);
      background: var(--surface);
    }

    .resource-card-main {
      display: grid;
      gap: 0.75rem;
    }

    .resource-kicker {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      align-items: center;
      color: var(--accent);
      font-size: 0.78rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .resource-kicker span {
      display: inline-flex;
      align-items: center;
      border: 1px solid rgba(184, 155, 94, 0.38);
      border-radius: 999px;
      padding: 0.28rem 0.55rem;
      background: rgba(184, 155, 94, 0.08);
    }

    .resource-card h3 {
      font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    }

    .resource-card p {
      margin: 0;
      color: var(--text-muted);
    }

    .resource-byline {
      color: var(--primary) !important;
      font-weight: 800;
    }

    .resource-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 0.1rem;
    }

    .resource-tags span {
      display: inline-flex;
      align-items: center;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.34rem 0.62rem;
      background: var(--surface-muted);
      color: var(--primary);
      font-size: 0.78rem;
      font-weight: 800;
    }

    .resource-card-action {
      display: flex;
      justify-content: flex-end;
      min-width: 150px;
    }

    .resource-button,
    .resource-note {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      border-radius: 999px;
      padding: 0.7rem 0.95rem;
      border: 1px solid var(--primary);
      background: var(--primary);
      color: #fff;
      font-weight: 850;
      white-space: nowrap;
    }

    .resource-button:hover {
      color: #fff;
      transform: translateY(-1px);
    }

    .resource-note {
      border-color: var(--border);
      background: transparent;
      color: var(--text-muted);
    }

    @media (max-width: 880px) {
      .resource-section-header,
      .resource-card {
        grid-template-columns: 1fr;
      }

      .resource-section-header {
        padding-right: 3.5rem;
      }

      .resource-card-action {
        justify-content: flex-start;
      }
    }
  </style>
</BaseLayout>
