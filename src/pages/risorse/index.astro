---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';

const risorse = await getCollection('risorsa');

const categoryDefinitions = [
  {
    id: 'fondamenti',
    title: 'Fondamenti di intelligence',
    description: 'Testi e archivi utili per costruire una base culturale solida sul mestiere intelligence, sul ciclo informativo e sul rapporto tra analisi e decisione.',
    match: 'Fondamenti di intelligence'
  },
  {
    id: 'analisi-metodo',
    title: 'Analisi intelligence e SAT',
    description: 'Risorse dedicate a tradecraft, standard analitici, tecniche analitiche strutturate, qualità del giudizio e disciplina argomentativa.',
    match: 'Analisi intelligence e SAT'
  },
  {
    id: 'studiare-intelligence',
    title: 'Studiare intelligence',
    description: 'Atenei, scuole, centri studi e percorsi formativi utili per approfondire intelligence, analisi geopolitica, OSINT, security studies e cultura strategica.',
    match: 'Studiare intelligence'
  },
  {
    id: 'osint',
    title: 'OSINT e ambiente informativo',
    description: 'Toolkit, laboratori e fonti utili per l’analisi di fonti aperte, la verifica dei contenuti digitali e la ricerca online strutturata.',
    match: 'OSINT e ambiente informativo'
  },
  {
    id: 'geopolitica',
    title: 'Geopolitica e sicurezza internazionale',
    description: 'Think tank, riviste e piattaforme di analisi utili per seguire conflitti, crisi regionali, sicurezza internazionale e competizione strategica.',
    match: 'Geopolitica e sicurezza internazionale'
  },
  {
    id: 'cyber',
    title: 'Cyber, tecnologia e minacce digitali',
    description: 'Report e fonti per comprendere minacce cyber, criminalità digitale, cyber threat intelligence e impatti delle tecnologie emergenti.',
    match: 'Cyber, tecnologia e minacce digitali'
  },
  {
    id: 'influenza',
    title: 'Disinformazione, influenza e comunicazione strategica',
    description: 'Risorse su propaganda, operazioni informative, influenza, comunicazione strategica e resilienza dell’ambiente informativo.',
    match: 'Disinformazione, influenza e comunicazione strategica'
  }
];

const groups = categoryDefinitions
  .map((category) => {
    const items = risorse
      .filter((risorsa) => risorsa.data.category === category.match)
      .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'it'));
    return { ...category, items };
  })
  .filter((category) => category.items.length > 0);

const getMeta = (risorsa) => [
  risorsa.data.type,
  risorsa.data.level,
  risorsa.data.language,
  risorsa.data.year ? String(risorsa.data.year) : ''
].filter(Boolean).join(' · ');
---
<BaseLayout title="Risorse consigliate — Lab4Int - Intelligence Analysis Laboratory" description="Bibliografia ragionata, siti, report, toolkit e risorse utili per approfondire intelligence analysis, OSINT, geopolitica, cyber e disinformazione.">
  <Hero
    eyebrow="Risorse consigliate"
    title="Letture, siti e strumenti per approfondire l’intelligence"
    description="Una selezione ragionata di testi, archivi, toolkit, report e siti utili per orientarsi nello studio dell’intelligence, dell’analisi strategica e delle minacce contemporanee."
    primaryHref="/pubblicazioni/"
    primaryLabel="Consulta le pubblicazioni"
    secondaryHref="/contatti/"
    secondaryLabel="Suggerisci una risorsa"
  />

  <section class="page-section resources-intro compact-section">
    <div class="panel">
      <p class="eyebrow">Criterio editoriale</p>
      <h2>Una selezione non esaustiva, ma ragionata</h2>
      <p>
        Questa pagina non intende sostituire una bibliografia accademica completa. Raccoglie piuttosto risorse selezionate per utilità formativa, qualità metodologica e rilevanza pratica per chi studia o insegna intelligence analysis, geopolitica, OSINT, sicurezza e crisis management.
      </p>
    </div>
  </section>

  <section class="page-section resources-catalog">
    {groups.map((group) => (
      <section class="resource-section" aria-labelledby={`resource-section-${group.id}`}>
        <header class="resource-section-header">
          <p class="eyebrow">{group.items.length} {group.items.length === 1 ? 'risorsa' : 'risorse'}</p>
          <div>
            <h2 id={`resource-section-${group.id}`}>{group.title}</h2>
            <p>{group.description}</p>
          </div>
        </header>

        <div class="resource-list">
          {group.items.map((risorsa) => (
            <article class="resource-card panel">
              <div class="resource-card-main">
                <div class="resource-kicker">
                  <span>{getMeta(risorsa)}</span>
                  {risorsa.data.featured && <span>Essenziale</span>}
                </div>

                <h3>{risorsa.data.title}</h3>

                {(risorsa.data.author || risorsa.data.institution) && (
                  <p class="resource-byline">
                    {risorsa.data.author && <span>{risorsa.data.author}</span>}
                    {risorsa.data.author && risorsa.data.institution && <span> · </span>}
                    {risorsa.data.institution && <span>{risorsa.data.institution}</span>}
                  </p>
                )}

                <p>{risorsa.data.description}</p>

                {risorsa.data.tags.length > 0 && (
                  <div class="resource-tags" aria-label="Temi della risorsa">
                    {risorsa.data.tags.map((tag) => <span>{tag}</span>)}
                  </div>
                )}
              </div>

              <div class="resource-card-action">
                {risorsa.data.link ? (
                  <a class="resource-button" href={risorsa.data.link} target="_blank" rel="noopener noreferrer">Apri risorsa</a>
                ) : (
                  <span class="resource-note">Riferimento bibliografico</span>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </section>


  <section class="page-section compact-section">
    <div class="panel resources-cta">
      <div>
        <p class="card-meta">Segnalazioni</p>
        <h2>Conosci una risorsa utile da aggiungere?</h2>
        <p>
          Puoi segnalare testi, report, toolkit, archivi, centri studi o percorsi formativi
          pertinenti a intelligence analysis, OSINT, geopolitica, cyber, disinformazione e cultura strategica.
        </p>
      </div>
      <div class="resources-cta-actions">
        <a class="button primary" href="/contatti/">Suggerisci una risorsa</a>
        <a class="button secondary" href="/pubblicazioni/">Consulta le pubblicazioni</a>
      </div>
    </div>
  </section>

  <style>

    .resources-cta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.25rem;
    }

    .resources-cta h2 {
      font-size: clamp(1.55rem, 3vw, 2.15rem);
      margin-bottom: 0.55rem;
    }

    .resources-cta p {
      max-width: 780px;
      margin: 0;
      color: var(--text-muted);
    }

    .resources-cta-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      justify-content: flex-end;
    }

    @media (max-width: 860px) {
      .resources-cta {
        align-items: flex-start;
        flex-direction: column;
      }

      .resources-cta-actions {
        justify-content: flex-start;
      }
    }

    .resources-intro {
      padding-top: 2rem;
      padding-bottom: 1rem;
    }

    .resources-intro .panel {
      display: grid;
      gap: 0.7rem;
    }

    .resources-intro h2 {
      font-size: clamp(1.65rem, 3vw, 2.35rem);
    }

    .resources-intro p:last-child {
      max-width: 900px;
      margin: 0;
      color: var(--text-muted);
    }

    .resources-catalog {
      display: grid;
      gap: 3rem;
      padding-top: 2.5rem;
    }

    .resource-section {
      display: grid;
      gap: 1.15rem;
    }

    .resource-section-header {
      display: grid;
      grid-template-columns: minmax(120px, 0.22fr) minmax(0, 1fr);
      gap: 1rem;
      align-items: start;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
    }

    .resource-section-header h2 {
      margin-bottom: 0.45rem;
      font-size: clamp(1.65rem, 3vw, 2.45rem);
    }

    .resource-section-header p:last-child {
      max-width: 820px;
      margin: 0;
      color: var(--text-muted);
    }

    .resource-list {
      display: grid;
      gap: 0.95rem;
    }

    .resource-card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1.25rem;
      align-items: start;
      padding: 1.15rem;
    }

    .resource-card-main {
      display: grid;
      gap: 0.75rem;
    }

    .resource-kicker {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      align-items: center;
      color: var(--accent);
      font-size: 0.78rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .resource-kicker span {
      display: inline-flex;
      align-items: center;
      border: 1px solid rgba(184, 155, 94, 0.38);
      border-radius: 999px;
      padding: 0.28rem 0.55rem;
      background: rgba(184, 155, 94, 0.08);
    }

    .resource-card h3 {
      font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    }

    .resource-card p {
      margin: 0;
      color: var(--text-muted);
    }

    .resource-byline {
      color: var(--primary) !important;
      font-weight: 800;
    }

    .resource-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 0.1rem;
    }

    .resource-tags span {
      display: inline-flex;
      align-items: center;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.34rem 0.62rem;
      background: var(--surface-muted);
      color: var(--primary);
      font-size: 0.78rem;
      font-weight: 800;
    }

    .resource-card-action {
      display: flex;
      justify-content: flex-end;
      min-width: 150px;
    }

    .resource-button,
    .resource-note {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      border-radius: 999px;
      padding: 0.7rem 0.95rem;
      border: 1px solid var(--primary);
      background: var(--primary);
      color: #fff;
      font-weight: 850;
      white-space: nowrap;
    }

    .resource-button:hover {
      color: #fff;
      transform: translateY(-1px);
    }

    .resource-note {
      border-color: var(--border);
      background: transparent;
      color: var(--text-muted);
    }

    @media (max-width: 880px) {
      .resource-section-header,
      .resource-card {
        grid-template-columns: 1fr;
      }

      .resource-card-action {
        justify-content: flex-start;
      }
    }
  </style>
</BaseLayout>
