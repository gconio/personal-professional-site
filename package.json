{
  "name": "personal-professional-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "editorial:validate": "node scripts/editorial/validate-content.mjs",
    "editorial:publication-check": "node scripts/editorial/check-publication-profile.mjs --changed",
    "editorial:publication-audit": "node scripts/editorial/check-publication-profile.mjs --all",
    "editorial:new-publication": "node scripts/editorial/new-publication.mjs",
    "editorial:inventory": "node scripts/editorial/generate-inventory.mjs",
    "editorial:links": "node scripts/editorial/check-generated-links.mjs",
    "editorial:scope": "node scripts/editorial/check-change-scope.mjs",
    "editorial:check": "npm run editorial:validate && npm run editorial:publication-check && npm run editorial:quality && npm run editorial:inventory && npm run editorial:governance && npm run editorial:dashboard && npm run build && npm run editorial:links",
    "editorial:quality": "node scripts/editorial/quality-report.mjs",
    "editorial:governance": "node scripts/editorial/governance-report.mjs",
    "editorial:dashboard": "node scripts/editorial/dashboard-report.mjs",
    "editorial:dashboard:console": "node scripts/editorial/dashboard-report.mjs --console",
    "editorial:knowledge-model": "node scripts/editorial/intelligence/knowledge-model.mjs",
    "editorial:opportunity-radar": "node scripts/editorial/intelligence/opportunity-radar.mjs",
    "editorial:mission-planner": "node scripts/editorial/intelligence/mission-planner.mjs",
    "editorial:prepare": "node scripts/editorial/pipeline/prepare.mjs",
    "editorial:verify": "node scripts/editorial/pipeline/verify.mjs",
    "editorial:preview": "node scripts/editorial/pipeline/preview.mjs",
    "editorial:publish-plan": "node scripts/editorial/pipeline/publish-plan.mjs",
    "editorial:status": "node scripts/editorial/pipeline/status.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^5.0.0"
  }
}
